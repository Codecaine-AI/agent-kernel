                            "raw": "{"eventId":"d51c5586-0949-07f9-9f1d-5fd7d11701f8","containerId":"8e60b276-ada2-5668-9a14-67003435e0fe","runId":"6060f11e-3e2a-4fcc-b1ba-4f325e3cd0a7","piSessionId":"019f24bc-1e52-71f7-8bf9-5d024171671f","agentId":null,"userId":null,"type":"pi_turn_start","source":"agent","traceLevel":3,"eventData":{"turn_number":2},"spanId":null,"parentEventId":null,"timestamp":"2026-07-02T21:28:59.503Z"}",
