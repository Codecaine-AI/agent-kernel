{
  "name": "pi-agent-kernel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "dev:simple-research": "bun run --cwd examples/simple-research-kernel dev",
    "dev:services": "bun run scripts/dev-services.ts",
    "test": "bun run test:boundaries && bun run test:packages",
    "test:boundaries": "bun run scripts/check-package-boundaries.ts",
    "test:packages": "bun test ./packages/kernel/src ./packages/tailer/src ./packages/viewer-core/src ./packages/prompt-kit/src/renderers/xml-markdown/render.test.ts ./packages/prompt-kit/src/validation/validate-tree.test.ts ./packages/prompt-kit/src/transforms/transforms.test.ts ./packages/prompt-kit/src/ui/editors/editor-model.test.ts ./examples/simple-research-kernel/src/agent-catalog/prompt-snapshots.test.ts",
    "typecheck": "bun run typecheck:protocol && bun run typecheck:db && bun run typecheck:prompt-kit && bun run typecheck:kernel && bun run typecheck:tailer && bun run typecheck:viewer-core && bun run typecheck:viewer-ui && bun run typecheck:viewer-shell && bun run typecheck:examples",
    "typecheck:protocol": "bunx --bun tsc -p packages/protocol/tsconfig.json --noEmit",
    "typecheck:db": "bunx --bun tsc -p packages/db/tsconfig.json --noEmit",
    "typecheck:prompt-kit": "bunx --bun tsc -p packages/prompt-kit/tsconfig.json --noEmit",
    "typecheck:kernel": "bunx --bun tsc -p packages/kernel/tsconfig.json --noEmit",
    "typecheck:tailer": "bunx --bun tsc -p packages/tailer/tsconfig.json --noEmit",
    "typecheck:viewer-core": "bunx --bun tsc -p packages/viewer-core/tsconfig.json --noEmit",
    "typecheck:viewer-ui": "bunx --bun tsc -p packages/viewer-ui/tsconfig.json --noEmit",
    "typecheck:viewer-shell": "bunx --bun tsc -p packages/viewer-shell/tsconfig.json --noEmit",
    "typecheck:examples": "bun run --cwd examples/simple-research-kernel typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
