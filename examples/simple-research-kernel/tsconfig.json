{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["bun", "react", "react-dom"],
    "noEmit": true,
    // `paths` replaces the extended config's paths, so its React pins are repeated here,
    // relative to this file, beside the app's `@/` alias (design-system guide/code-structure.md).
    "paths": {
      "@/*": ["./src/*"],
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom": ["../../node_modules/@types/react-dom"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
