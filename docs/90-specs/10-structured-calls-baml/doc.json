    "b-baml-proposal-09": {
      "id": "b-baml-proposal-09",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Proposed flow. The request has the same shape as one agent turn: system prompt, context block, then the input. BAML appends the output format and parses the reply into the declared type. Trace steps name the event they emit."
        }
      ],
      "children": []
    },
    "d83f6a97-ef67-4656-99fe-bf546eed60a7": {
      "id": "d83f6a97-ef67-4656-99fe-bf546eed60a7",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Proposed structured call",
            "steps": [
              {
                "text": "Harness calls `kernel.call(fnName, input, opts)`"
              },
              {
                "text": "Kernel resolves the model: `opts.model`, then the manifest default, then the kernel default, all through `models.aliases`",
                "steps": [
                  {
                    "text": "Builds a `ClientRegistry` with the credential read from Pi's store (`readStoredCredential`).",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Kernel mints identity: one function session (kind `\"function\"`, `promptHash` of the `.baml` source) and one run (`agentName = fnName`, `containerId`, `parentRunId`, `trigger`)"
              },
              {
                "text": "Kernel emits `baml_call_start` (input blob, resolved model, `promptHash`)",
                "trace": true
              },
              {
                "text": "BAML runtime invokes the function with the collector, the client registry, and the abort signal",
                "steps": [
                  {
                    "text": "Provider HTTP calls, retries, and fallbacks are additional calls.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Kernel emits one turn per collector call: `pi_turn_start` and `pi_turn_end` with `TurnUsage` and `costEstimate` from `models.prices`, plus `pi_request_snapshot` from the raw HTTP body",
                "trace": true
              },
              {
                "text": "Kernel emits `baml_call_end` (output blob, status, rolled-up usage), then closes the run and session",
                "trace": true
              },
              {
                "text": "Harness receives the typed object",
                "steps": [
                  {
                    "text": "On parse failure BAML throws. The run ends `error`, and the raw response stays in the blob.",
                    "kind": "note"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
