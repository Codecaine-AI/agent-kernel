    "b-baml-proposal-01": {
      "id": "b-baml-proposal-01",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A structured call is one model request in, one typed object out. It has the same request shape as one agent turn (system prompt, context block, input) but runs a single turn, has no tools, and returns a typed result. Deterministic harness code calls it at fixed points in a process: summarize, classify, extract. It is "
        },
        {
          "insert": "kernel.call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a second kernel primitive beside "
        },
        {
          "insert": "spawnAgent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-baml-proposal-02": {
      "id": "b-baml-proposal-02",
      "type": "callout",
      "props": {},
      "text": [
        {
          "insert": "Status: proposal, nothing built. First step: a one-day spike in "
        },
        {
          "insert": "spikes/baml-bun/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " that calls one BAML function through codex-lb under Bun and captures Collector output."
        }
      ],
      "children": []
    },
