    "gc-01": {
      "id": "gc-01",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The GameCube decomp orchestrator already uses all three model node types, mostly built by hand. Agent runs work as they are. Extraction is five hand-written JSON parses that scavenge from the first "
        },
        {
          "insert": "{",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to the last "
        },
        {
          "insert": "}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Decisions are regex over free text plus fixed counters."
        }
      ],
      "children": []
    },
    "gc-02": {
      "id": "gc-02",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Deterministic gates stay deterministic: objdiff matching, micro-gates, confirmation bisect, and policy merge. This page maps each model site to its node type, picks the first target, and sizes the work. Paths are relative to "
        },
        {
          "insert": "apps/server/src/core/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "gamecube-decomp-harness",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
