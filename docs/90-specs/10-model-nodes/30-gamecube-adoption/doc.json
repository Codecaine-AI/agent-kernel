    "gc-05": {
      "id": "gc-05",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The orchestrator loop starts at "
        },
        {
          "insert": "harness-runtime/phases/running/scheduler/run-loop.ts:907",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Brackets mark the node type a step would use: AGENT is "
        },
        {
          "insert": "spawnAgent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", CALL is "
        },
        {
          "insert": "kernel.call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and DECISION is "
        },
        {
          "insert": "kernel.decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Unmarked steps are deterministic code."
        }
      ],
      "children": []
    },
    "gc-06": {
      "id": "gc-06",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Orchestrator Loop, One Tick",
            "steps": [
              {
                "text": "Housekeeping",
                "steps": [
                  {
                    "text": "Orchestrator sends a heartbeat and probes the provider circuit"
                  },
                  {
                    "text": "Orchestrator reaps dead jobs and requeues their targets"
                  },
                  {
                    "text": "Orchestrator drains the integration queue with `git apply` of each best checkpoint"
                  },
                  {
                    "text": "Orchestrator runs knowledge maintenance"
                  },
                  {
                    "text": "The summarizer lane, the `checkpoint_adjudication` and `checkpoint_knowledge` lanes, and the librarian lane with `--librarian-consumer` run in the background.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "If the Epoch Is Drained, Run `runEpochBoundary`",
                "steps": [
                  {
                    "text": "Orchestrator settles the epoch and builds the report"
                  },
                  {
                    "text": "Orchestrator runs the codex build fixer [AGENT]"
                  },
                  {
                    "text": "Orchestrator plans regressions, runs the confirmation bisect, and runs QA L2"
                  },
                  {
                    "text": "Orchestrator syncs upstream and runs policy merge, then the fixer [AGENT]"
                  },
                  {
                    "text": "Orchestrator opens a draft PR"
                  }
                ]
              },
              {
                "text": "Otherwise, Admit Targets",
                "steps": [
                  {
                    "text": "Orchestrator admits targets"
                  },
                  {
                    "text": "Worker job consumers claim them"
                  }
                ]
              },
              {
                "text": "Worker Job Runs One Claimed Target",
                "steps": [
                  {
                    "text": "Pi worker edits the target [AGENT]"
                  },
                  {
                    "text": "Worker job parses the note with `parseWorkerCheckpointNote`, a deterministic JSON parse"
                  },
                  {
                    "text": "Worker job checks the change in code",
                    "steps": [
                      {
                        "text": "Worker job computes the diff, runs lint, and applies write-set widening"
                      },
                      {
                        "text": "Worker job validates with objdiff, micro-gates, and QA L1"
                      },
                      {
                        "text": "Both checks are deterministic and stay in code.",
                        "kind": "note"
                      }
                    ]
                  },
                  {
                    "text": "In enforce, the worker job adjudicates `llm_review` advisories inline [CALL, DECISION, new]. In shadow, the `checkpoint_adjudication` lane adjudicates them out of band."
                  },
                  {
                    "text": "Worker job records the checkpoint and decides whether to continue"
                  },
                  {
                    "text": "The worker job runs in a `worker-task` child process.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Close the Tick",
                "steps": [
                  {
                    "text": "Orchestrator enqueues integration and the worker summary [AGENT]"
                  },
                  {
                    "text": "Orchestrator checks stop conditions"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
