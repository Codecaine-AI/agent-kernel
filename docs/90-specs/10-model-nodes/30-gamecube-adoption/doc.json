    "gc-05": {
      "id": "gc-05",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The orchestrator loop starts at "
        },
        {
          "insert": "harness-runtime/phases/running/run-loop.ts:882",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Brackets mark the node type a step would use: AGENT is "
        },
        {
          "insert": "spawnAgent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", CALL is "
        },
        {
          "insert": "kernel.call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and DECISION is "
        },
        {
          "insert": "kernel.decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Unmarked steps are deterministic code."
        }
      ],
      "children": []
    },
    "gc-06": {
      "id": "gc-06",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Orchestrator loop, one tick",
            "steps": [
              {
                "text": "Orchestrator sends a heartbeat and probes the provider circuit"
              },
              {
                "text": "Orchestrator reaps dead jobs and requeues their targets"
              },
              {
                "text": "Orchestrator drains the integration queue with `git apply` of each best checkpoint"
              },
              {
                "text": "Orchestrator runs knowledge maintenance",
                "steps": [
                  {
                    "text": "The summarizer and librarian lanes run as background consumers.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "If the epoch is drained, orchestrator runs `runEpochBoundary`",
                "steps": [
                  {
                    "text": "Settles the epoch"
                  },
                  {
                    "text": "Builds the report, then runs the codex build fixer [AGENT]"
                  },
                  {
                    "text": "Plans regressions and runs the confirmation bisect"
                  },
                  {
                    "text": "Runs QA L2"
                  },
                  {
                    "text": "Syncs upstream and runs policy merge, then the fixer [AGENT]"
                  },
                  {
                    "text": "Opens a draft PR"
                  }
                ]
              },
              {
                "text": "Otherwise orchestrator admits targets, and worker job consumers claim them"
              },
              {
                "text": "Worker job runs one claimed target",
                "steps": [
                  {
                    "text": "Pi worker edits the target [AGENT]"
                  },
                  {
                    "text": "Worker job parses the checkpoint note [CALL]"
                  },
                  {
                    "text": "Worker job computes the diff, runs lint, and applies write-set widening"
                  },
                  {
                    "text": "Worker job validates with objdiff, micro-gates, and QA L1",
                    "steps": [
                      {
                        "text": "Deterministic. Stays in code.",
                        "kind": "note"
                      }
                    ]
                  },
                  {
                    "text": "Worker job adjudicates `llm_review` advisories [DECISION, new]"
                  },
                  {
                    "text": "Worker job records the checkpoint"
                  },
                  {
                    "text": "Worker job decides whether to continue [DECISION]"
                  }
                ]
              },
              {
                "text": "Orchestrator enqueues integration and the worker summary [CALL]"
              },
              {
                "text": "Orchestrator checks stop conditions"
              }
            ]
          }
        ]
      },
      "children": []
    },
