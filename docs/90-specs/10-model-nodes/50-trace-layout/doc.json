    "tl-calls-lead": {
      "id": "tl-calls-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every model node goes out and comes back. The harness sends work out through the kernel, gets a typed answer back, and branches in its own code. The kernel writes each leg to the Trace DB. Attempt 2 repeats the attempt 1 pattern, so the diagram collapses it."
        }
      ],
      "children": []
    },
