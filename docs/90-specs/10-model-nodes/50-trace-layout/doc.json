    "tl-tree-lead": {
      "id": "tl-tree-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The viewer builds one tree per container. Both worker attempts sit in one "
        },
        {
          "insert": "pi",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " session. Each call, decision, and step nests under the worker run it describes. Steps marked as trace lines map to real paired events. "
        },
        {
          "insert": "Trace UI",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "90-specs/10-model-nodes/60-trace-ui"
            }
          }
        },
        {
          "insert": " shows how the viewer draws this tree."
        }
      ],
      "children": []
    },
    "tl-tree": {
      "id": "tl-tree",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Container `worker-job/fn_8003A1C4`: 7 runs, 3 steps, about 7m10s, about $0.63",
            "steps": [
              {
                "text": "Session `worker`, kind `pi`: holds both attempts",
                "steps": [
                  {
                    "text": "`R1` agent run `worker`, attempt 1, trigger `system`: 14 turns, 31 tool calls, 4m12s, $0.38",
                    "trace": true,
                    "steps": [
                      {
                        "text": "Turns 1 to 14: `pi_request_snapshot`, `pi_turn_start`, `pi_turn_end`, with 31 tool call spans folded under their turns",
                        "trace": true
                      },
                      {
                        "text": "`R2` call `ExtractCheckpointNote`, trigger `post-run`, engine `baml`: 1 turn, 1.8 s, $0.004",
                        "trace": true,
                        "steps": [
                          {
                            "text": "Output: status `partial`, one kept advisory `type_erasing_cast` on `(u32)this->mpActor`.",
                            "kind": "note"
                          }
                        ]
                      },
                      {
                        "text": "`S1` step `validate`, attached to `R1`: 6.3 s",
                        "trace": true,
                        "steps": [
                          {
                            "text": "objdiff 97.4%, not exact. Micro-gates 5/5 pass. review_lint: one `llm_review` warning, `type_erasing_cast`.",
                            "kind": "note"
                          }
                        ]
                      },
                      {
                        "text": "`R3` decision `JudgeAdvisory`, trigger `judge`, engine `jev`, model `jev-1.13.0`: 110 ms, 1,412 input tokens, $0.00006",
                        "trace": true,
                        "steps": [
                          {
                            "text": "Question `justified` (binary): p=0.91, confidence source `native`. Threshold 0.85, so the harness accepts the advisory.",
                            "kind": "note"
                          }
                        ]
                      },
                      {
                        "text": "`R4` decision `ContinueOrStop`, trigger `judge`, engine `jev`: 95 ms, 968 input tokens, $0.00004",
                        "trace": true,
                        "steps": [
                          {
                            "text": "`retry_same_approach` 0.21, `retry_new_strategy` 0.71, `stop_blocked` 0.08. Confidence 0.64, `native`. Chosen: `retry_new_strategy`.",
                            "kind": "note"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "text": "`R5` agent run `worker`, attempt 2, trigger `steer`, strategy hint in the message: 9 turns, 18 tool calls, 2m40s, $0.24",
                    "trace": true,
                    "steps": [
                      {
                        "text": "Turns 1 to 9, with 18 tool call spans folded under their turns",
                        "trace": true
                      },
                      {
                        "text": "`R6` call `ExtractCheckpointNote`, trigger `post-run`, engine `baml`: 1.8 s",
                        "trace": true
                      },
                      {
                        "text": "`S2` step `validate`, attached to `R5`: 5.4 s",
                        "trace": true,
                        "steps": [
                          {
                            "text": "objdiff 100%, exact. Gates 5/5. Lint clean.",
                            "kind": "note"
                          }
                        ]
                      },
                      {
                        "text": "`S3` step `stop`, attached to `R5`: 20 ms",
                        "trace": true,
                        "steps": [
                          {
                            "text": "Exact and clean, so the harness stops the job.",
                            "kind": "note"
                          }
                        ]
                      },
                      {
                        "text": "`R7` call `SummarizeWorkerRun`, trigger `post-run`, engine `baml`: 1.4 s",
                        "trace": true,
                        "steps": [
                          {
                            "text": "The harness writes the narrative to the knowledge DB.",
                            "kind": "note"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
