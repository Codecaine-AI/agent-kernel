    "tl-intro": {
      "id": "tl-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "One worker job produces one container of nested spans. This page traces container "
        },
        {
          "insert": "worker-job/fn_8003A1C4",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the GameCube decomp target "
        },
        {
          "insert": "fn_8003A1C4",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "d_a_player.cpp",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It shows who calls whom, the span tree the viewer builds, and what each node records. The job runs two worker attempts, three calls, two decisions, and three code steps."
        }
      ],
      "children": []
    },
