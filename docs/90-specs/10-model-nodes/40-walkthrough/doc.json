    "wt-code-lead": {
      "id": "wt-code-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "runWorkerJob(target)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs one claimed target, and a comment on every branch names who decides it: code or a model. The tags R1 to R7 and S1 to S3 match the steps in What This Run Did. The questions are "
        },
        {
          "insert": "BoolQuestion",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "ChoiceQuestion",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " objects, as defined in "
        },
        {
          "insert": "Decision Nodes",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "90-specs/10-model-nodes/20-decision-nodes"
            }
          }
        },
        {
          "insert": ". The kernel exports no "
        },
        {
          "insert": "bool",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "choice",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " helper. No line calls Jev directly, because "
        },
        {
          "insert": "kernel.decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " sends each question through Pi "
        },
        {
          "insert": "classify()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the model alias "
        },
        {
          "insert": "typesafe/jev-1.13.0",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "wt-code": {
      "id": "wt-code",
      "type": "code",
      "props": {
        "language": "typescript"
      },
      "text": [
        {
          "insert": "// Pseudocode. Not runnable.\nasync function runWorkerJob(target: Target) {\n  const ids = { containerId: `worker-job/${target.fn}` }; // worker-job/fn_8003A1C4\n  const claim = await claimTarget(target);\n  let attempt = 0;\n  let session: string | undefined;\n  let lastRunId: string | undefined;\n  let hint: string | undefined;\n  let stopReason: string | undefined;\n\n  // code decides: no attempt starts after the claim deadline or budget\n  while (!claim.deadlinePassed() && attempt < claim.attemptBudget) {\n    attempt += 1;\n\n    // agent does the work (R1, then R5 in the same session)\n    const run = await spawnAgent(\"worker\", {\n      ...ids, session, trigger: attempt === 1 ? \"system\" : \"steer\",\n      prompt: workerPrompt(target, hint),\n    });\n    session = run.sessionId;\n    lastRunId = run.id;\n    const under = { ...ids, parentRunId: run.id };\n\n    // call maps each advisory to the note's justification (R2)\n    const note = await kernel.call(\"ExtractCheckpointKnowledge\", [noteText, findings], {\n      ...under, trigger: \"post-run\",\n    });\n\n    // code step: objdiff, micro-gates, review_lint (S1, S2)\n    const v = await kernel.step(\"validate\", under, () => validate(target, run.diff));\n\n    // code decides: exact match, gates pass, lint clean ends the job\n    if (v.objdiff === 100 && v.gatesPassed && v.lint.length === 0) {\n      stopReason = \"exact_match\";\n      break;\n    }\n\n    // model decides: is each kept advisory justified? (R3)\n    // kernel.decide runs Pi classify(), and Pi calls the Jev System One API\n    for (const adv of note.advisories.filter((a) => a.kept)) {\n      const { answers: { justified } } = await kernel.decide(\"JudgeAdvisory\", adv, {\n        ...under, trigger: \"judge\", model: \"typesafe/jev-1.13.0\",\n        questions: { justified: {\n          type: \"bool\", instructions: \"Does the original asm need this hunk as written?\",\n          criteria: { true: \"needed as written\", false: \"not needed\" }, passAt: 0.85, failAt: 0.15,\n        } },\n      });\n      const p = justified.probability; // the kernel sets justified.verdict from passAt and failAt\n      if (justified.verdict === \"pass\") continue; // p >= 0.85: accepted\n      if (justified.verdict === \"fail\") { hint = repairInstruction(adv); continue; } // p <= 0.15: rejected\n\n      // call decides the unsure band only in enforce with escalateLowConfidence, which ships off\n      const second = await kernel.call(\"JudgeAdvisoryWithRationale\", [adv], { ...under, trigger: \"judge\" });\n      if (second.verdict === \"REJECTED\") hint = repairInstruction(adv, second.rationale);\n      // NEEDS_INFO leaves the abstain: enforce fails closed. No operator queue exists.\n    }\n\n    // model decides: retry, change strategy, or stop (R4), again through Pi classify()\n    const { answers: { next } } = await kernel.decide(\"ContinueOrStop\", { note, validation: v }, {\n      ...under, trigger: \"judge\", model: \"typesafe/jev-1.13.0\",\n      questions: { next: {\n        type: \"choice\", instructions: \"What should the next attempt do?\", minTop: 0.6, minMargin: 0.2,\n        criteria: { retry_same_approach: \"close\", retry_new_strategy: \"stuck\", stop_blocked: \"blocked\" },\n      } },\n    });\n    if (next.abstained) continue; // code decides: the attempt budget takes over\n    if (next.choice === \"stop_blocked\") { stopReason = \"blocked\"; break; }\n    if (next.choice === \"retry_new_strategy\") hint = strategyHint(note);\n  }\n\n  // code step: record why the job ended (S3). No model involved.\n  await kernel.step(\"stop\", ids, () => ({ reason: stopReason ?? \"deadline_or_budget\" }));\n  // call writes the narrative to the knowledge DB (R7)\n  await kernel.call(\"SummarizeWorkerRun\", { session }, {\n    ...ids, parentRunId: lastRunId, trigger: \"post-run\",\n  });\n}"
        }
      ],
      "children": []
    },
