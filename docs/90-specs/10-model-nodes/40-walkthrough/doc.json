        "rows": [
          [
            "Exact match stop",
            "Code",
            "Objdiff 100%, micro-gates 5/5, and a clean lint are facts. A model adds cost and a chance to be wrong."
          ],
          [
            "Deadline stop",
            "Code",
            "The claim deadline and the attempt budget are a clock check and a counter."
          ],
          [
            "Advisory justified?",
            [
              {
                "insert": "Decision node "
