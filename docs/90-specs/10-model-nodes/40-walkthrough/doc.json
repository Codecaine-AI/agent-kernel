    "wt-who-lead": {
      "id": "wt-who-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Code decides anything that is a fact or a count. A model decides only where the answer needs judgment. A human gets the case only when both the decision node and the BAML judge are unsure."
        }
      ],
      "children": []
    },
    "wt-who-table": {
      "id": "wt-who-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Branch point",
