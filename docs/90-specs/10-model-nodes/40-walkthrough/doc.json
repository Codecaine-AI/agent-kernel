    "wt-code-lead": {
      "id": "wt-code-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "runWorkerJob(target)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs one claimed target. Every branch has a comment that names who decides it: code, a model, or a human. The tags R1 to R7 and S1 to S3 match the steps in What This Run Did. The "
        },
        {
          "insert": "noul",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "choice",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " helpers build Jev questions, as defined in "
        },
        {
          "insert": "Decision Nodes",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "90-specs/10-model-nodes/20-decision-nodes"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "wt-code": {
      "id": "wt-code",
      "type": "code",
      "props": {
        "language": "typescript"
      },
      "text": [
        {
          "insert": "// Pseudocode for a proposed API. Not runnable.\nasync function runWorkerJob(target: Target) {\n  const ids = { containerId: `worker-job/${target.fn}` }; // worker-job/fn_8003A1C4\n  const claim = await claimTarget(target);\n  let attempt = 0;\n  let session: string | undefined;\n  let lastRunId: string | undefined;\n  let hint: string | undefined;\n  let stopReason: string | undefined;\n\n  // code decides: no attempt starts after the claim deadline or budget\n  while (!claim.deadlinePassed() && attempt < claim.attemptBudget) {\n    attempt += 1;\n\n    // agent does the work (R1, then R5 in the same session)\n    const run = await spawnAgent(\"worker\", {\n      ...ids, session, trigger: attempt === 1 ? \"system\" : \"steer\",\n      prompt: workerPrompt(target, hint),\n    });\n    session = run.sessionId;\n    lastRunId = run.id;\n    const under = { ...ids, parentRunId: run.id };\n\n    // call extracts a typed note from the transcript (R2, R6)\n    const note = await kernel.call(\"ExtractCheckpointNote\", run.transcript, {\n      ...under, trigger: \"post-run\",\n    });\n\n    // code step: objdiff, micro-gates, review_lint (S1, S2)\n    const v = await kernel.step(\"validate\", under, () => validate(target, run.diff));\n\n    // code decides: exact match, gates pass, lint clean ends the job\n    if (v.objdiff === 100 && v.gatesPassed && v.lint.length === 0) {\n      stopReason = \"exact_match\";\n      break;\n    }\n\n    // model decides: is each kept advisory justified? (R3)\n    for (const adv of note.keptAdvisories) {\n      const { justified } = await kernel.decide(\"JudgeAdvisory\", adv, {\n        ...under, trigger: \"judge\", engine: \"jev\", model: \"jev-1.13.0\",\n        questions: { justified: noul(\"The original asm needs this hunk as written.\") },\n      });\n      const p = justified.distribution.true;\n      if (p >= 0.85) continue; // code decides: accepted\n      if (p < 0.4) { hint = repairInstruction(adv); continue; } // code decides: rejected\n\n      // call decides: the unsure band gets a BAML judge with a rationale\n      const second = await kernel.call(\"JudgeAdvisoryWithRationale\", adv, { ...under, trigger: \"judge\" });\n      if (second.verdict === \"rejected\") hint = repairInstruction(adv, second.rationale);\n      if (second.verdict === \"needs_info\") {\n        await operatorQueue.push(adv, second.rationale); // human decides\n        stopReason = \"operator_review\";\n      }\n    }\n    if (stopReason) break;\n\n    // model decides: retry, change strategy, or stop (R4)\n    const { next } = await kernel.decide(\"ContinueOrStop\", { note, validation: v }, {\n      ...under, trigger: \"judge\", engine: \"jev\", abstainBelow: 0.5,\n      questions: { next: choice([\"retry_same_approach\", \"retry_new_strategy\", \"stop_blocked\"]) },\n    });\n    if (next.abstained) continue; // code decides: the attempt budget takes over\n    if (next.choice === \"stop_blocked\") { stopReason = \"blocked\"; break; }\n    if (next.choice === \"retry_new_strategy\") hint = strategyHint(note);\n  }\n\n  // code step: record why the job ended (S3). No model involved.\n  await kernel.step(\"stop\", ids, () => ({ reason: stopReason ?? \"deadline_or_budget\" }));\n  // call writes the narrative to the knowledge DB (R7)\n  await kernel.call(\"SummarizeWorkerRun\", { session }, {\n    ...ids, parentRunId: lastRunId, trigger: \"post-run\",\n  });\n}"
        }
      ],
      "children": []
