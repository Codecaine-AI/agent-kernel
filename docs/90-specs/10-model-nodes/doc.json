    "mn-chain-lead": {
      "id": "mn-chain-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A call sits between the agent and the decision. Jev accepts at most 32k tokens of state and gets less accurate on large, noisy input. A raw agent transcript is both. So a call first extracts a compact typed object from the transcript, and the decision judges that object."
        }
      ],
      "children": []
    },
    "mn-chain-outline": {
      "id": "mn-chain-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Proposed worker step",
            "steps": [
              {
                "text": "Harness calls `spawnAgent` for the worker",
                "steps": [
                  {
                    "text": "Kernel records the agent run (`agent_run_start`, `agent_run_end`) in a session of kind `pi`",
                    "trace": true
                  }
                ]
              },
              {
                "text": "Harness calls `kernel.call` with the worker transcript",
                "steps": [
                  {
                    "text": "Kernel records the call (`call_start`, `call_end`, engine `baml`) with trigger `post-run` and `parentRunId` set to the worker run",
                    "trace": true
                  },
                  {
                    "text": "Result: a compact typed object, well under the 32k token limit.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Harness calls `kernel.decide` with the extracted object",
                "steps": [
                  {
                    "text": "Kernel records the decision (`call_start`, `decision_made`, `call_end`, engine `jev`) with trigger `judge`",
                    "trace": true
                  },
                  {
                    "text": "Result: a choice, per-option probabilities, a confidence, and the confidence source.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Harness code branches on the choice",
                "steps": [
                  {
                    "text": "The kernel takes no part in this step. It only records the next node the harness starts.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Harness escalates a low-confidence decision",
                "steps": [
                  {
                    "text": "Harness calls `kernel.call` on a BAML judge that returns a verdict with a rationale"
                  },
                  {
                    "text": "Harness hands the case to a human when the BAML judge is also unsure"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
