    "mn-intro": {
      "id": "mn-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The kernel gets three model node types that share one identity and trace model. "
        },
        {
          "insert": "spawnAgent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs multi-turn work with tools, and "
        },
        {
          "insert": "kernel.call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " turns input into a typed object. "
        },
        {
          "insert": "kernel.decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " asks closed questions and returns probabilities, a confidence, and where the confidence came from. Harness code chains the nodes, and the kernel records each node without routing between them."
        }
      ],
      "children": []
    },
    "mn-status": {
      "id": "mn-status",
      "type": "callout",
      "props": {},
