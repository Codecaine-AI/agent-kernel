    "mn-intro": {
      "id": "mn-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The kernel gets three model node types that share one identity and trace model. "
        },
        {
          "insert": "spawnAgent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs multi-turn work with tools. "
        },
        {
          "insert": "kernel.call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " turns input into a typed object. "
        },
        {
          "insert": "kernel.decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " picks a branch and reports how sure it is. Harness code chains them. The kernel records every node and does not route between them."
        }
      ],
      "children": []
    },
