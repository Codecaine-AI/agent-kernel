    "mn-chain-lead": {
      "id": "mn-chain-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A call first extracts a compact typed object from the worker transcript, and the decision judges that object. Jev needs this step, because it accepts at most 32k tokens of state and loses accuracy on noisy input. OpenAI "
        },
        {
          "insert": "gpt-6-luna",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " accepts 922K tokens and 128 images, so size alone does not force the step on that engine. The step stays for every engine, because a compact object is more accurate, costs less, and keeps the decision portable to Jev."
        }
      ],
      "children": []
    },
    "mn-chain-outline": {
      "id": "mn-chain-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Proposed Worker Step",
            "steps": [
              {
                "text": "Run the Worker",
                "steps": [
                  {
                    "text": "Harness calls `spawnAgent` for the worker"
                  },
                  {
                    "text": "Kernel records `agent_run_start` and `agent_run_end` in a session of kind `pi`",
                    "trace": true
                  }
                ]
              },
              {
                "text": "Extract a Typed Object",
                "steps": [
                  {
                    "text": "Harness calls `kernel.call` with the worker transcript"
                  },
                  {
                    "text": "Kernel records `call_start` and `call_end` with engine `baml` and trigger `post-run`",
                    "trace": true
                  },
                  {
                    "text": "`parentRunId` points at the worker run.",
                    "kind": "note"
                  },
                  {
                    "text": "The result is a compact typed object, well under the 32k token limit of Jev.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Decide on the Object",
                "steps": [
                  {
                    "text": "Harness calls `kernel.decide` with the extracted object"
                  },
                  {
                    "text": "Kernel records `call_start`, `decision_made`, and `call_end` with engine `jev` and trigger `judge`",
                    "trace": true
                  },
                  {
                    "text": "The result holds each answer, its probabilities, a confidence, and the confidence source.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Branch in Harness Code",
                "steps": [
                  {
                    "text": "Harness code branches on the answer"
                  },
                  {
                    "text": "The kernel only records the next node that the harness starts.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Escalate an Abstained Decision",
                "steps": [
                  {
                    "text": "Harness calls `kernel.call` on a BAML judge that returns a verdict and a rationale"
                  },
                  {
                    "text": "Harness hands the case to a human when the BAML judge is also unsure"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
