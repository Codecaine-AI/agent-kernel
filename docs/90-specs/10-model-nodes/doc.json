    "mn-types-lead": {
      "id": "mn-types-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each node type answers a different question on a different engine. All three write the same container, session, run, and turn rows. Only the session "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tells them apart. A code step from "
        },
        {
          "insert": "kernel.step",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a fourth kind of span, not a model node."
        }
      ],
      "children": []
    },
