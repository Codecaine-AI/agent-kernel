        }
      ],
      "children": []
    },
    "b-dn-24": {
      "id": "b-dn-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "TypeSafe documents five patterns. Each one is a single "
        },
        {
          "insert": "decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " call plus a rule in harness code."
        }
      ],
      "children": []
    },
    "b-dn-25": {
      "id": "b-dn-25",
      "type": "structured-table",
      "props": {
        "columns": [
          "Pattern",
          "Questions",
          "Harness rule"
        ],
        "rows": [
          [
            "Judge",
            "Several binary questions, one per criterion",
            "Code combines the answers"
          ],
          [
            "Router",
            [
              {
                "insert": "One choice over branch names plus "
              },
              {
                "insert": "other",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Below a confidence floor, take the fallback branch"
          ],
          [
            "Rule check",
            "One binary question with explicit true and false criteria",
            "Act on the verdict"
          ],
          [
            "Speculative fan-out",
            "Every question the flow might need, in one call",
            "Code ignores the answers it does not use"
          ],
          [
            "Confidence-gated escalation",
            "Any",
            "Below about 0.5 to 0.6, escalate. Risky actions need above 0.85 to 0.9"
          ]
        ]
      },
      "children": []
    },
    "b-dn-26": {
      "id": "b-dn-26",
      "type": "callout",
      "props": {},
      "text": [
        {
          "insert": "TypeSafe states that confidence is not the probability of being correct. Set thresholds on your own labeled data, per pinned model version."
        }
      ],
      "children": []
    },
    "b-dn-27": {
      "id": "b-dn-27",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Escalation"
        }
      ],
      "children": []
    },
    "b-dn-28": {
      "id": "b-dn-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A low-confidence answer escalates instead of failing. \"Can't decide\" is "
        },
        {
          "insert": "abstained: true",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not an error. Proposed flow:"
        }
      ],
      "children": []
    },
    "b-dn-29": {
      "id": "b-dn-29",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Proposed decision with escalation",
            "steps": [
              {
                "text": "Harness calls `kernel.decide(name, state, opts)`"
              },
              {
                "text": "Kernel mints one session (kind `decision`) and one run under `parentRunId`"
              },
              {
                "text": "Jev answers every question in one parallel pass"
              },
              {
                "text": "Kernel emits `decision_made` with `engine: \"jev\"` and `confidenceSource: \"native\"`",
                "trace": true
              },
              {
                "text": "Harness compares `confidence` with its threshold",
                "steps": [
                  {
                    "text": "At or above the threshold, the harness branches on `chosen` and the flow ends.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Harness runs a BAML judge through `kernel.call` and gets a rationale",
                "steps": [
                  {
                    "text": "The judge records its own run, turns, and `baml_call_*` events. Its answer has `confidenceSource: \"self-reported\"`.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Harness marks the decision `abstained: true` and routes it to a human or operator",
                "steps": [
                  {
                    "text": "Only when the judge is still uncertain. This is a normal result, not an error.",
                    "kind": "note"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-dn-30": {
      "id": "b-dn-30",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "In the BAML judge, return uncertainty as data. Use "
        },
        {
          "insert": "@check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus a "
        },
        {
          "insert": "NeedsInfo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " member in the return union. Avoid "
        },
        {
          "insert": "@assert",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which throws and ends the run as an error."
        }
      ],
      "children": []
    },
    "b-dn-31": {
      "id": "b-dn-31",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Open Questions"
        }
      ],
      "children": []
    },
    "b-dn-32": {
      "id": "b-dn-32",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "promptHash",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for Jev. Jev has no prompt template, so the hash would cover the questions and criteria spec instead."
        }
      ],
      "children": []
    },
    "b-dn-33": {
      "id": "b-dn-33",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "pi_request_snapshot",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " assumes a chat request. The Jev body "
        },
        {
          "insert": "{model, state, questions}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " needs a non-chat snapshot shape."
