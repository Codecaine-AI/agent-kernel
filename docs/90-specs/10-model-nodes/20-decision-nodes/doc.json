  "title": "Decision Nodes",
  "root": "root",
  "blocks": {
    "root": {
      "id": "root",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A decision node asks a model a closed question and gets back a choice with probabilities, not text. The API is "
        },
        {
          "insert": "kernel.decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Harness code uses it for questions such as \"did we accomplish this?\", \"which branch next?\", \"does this pass rule X?\", and \"keep trying or stop?\"."
        }
      ],
      "children": [
        "b-dn-02",
        "b-dn-03",
        "b-dn-04",
