    "b-dn-22": {
      "id": "b-dn-22",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "decide",
            "kind": "action",
            "description": "Runs kernel.decide(name, state, opts). Asks every question in one engine call. A low-confidence answer returns abstained: true instead of throwing.",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Names the decision in the trace and the viewer card."
              },
              {
                "name": "state",
                "type": "string | object",
                "required": true,
                "description": "A filtered slice. Typically the output of a preceding kernel.call."
              },
              {
                "name": "opts",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "questions",
                    "type": "Record<questionId, Question>",
                    "required": true,
                    "fields": [
                      {
                        "name": "type",
                        "type": "\"choice\" | \"score\" | \"binary\"",
                        "required": true
                      },
                      {
                        "name": "instructions",
                        "type": "string",
                        "required": true,
                        "description": "The question text."
                      },
                      {
                        "name": "criteria",
                        "type": "Record<label, string>",
                        "required": true,
                        "description": "Defines each option, each level, or the true and false outcomes."
                      }
                    ]
                  },
                  {
                    "name": "containerId",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "parentRunId",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "trigger",
                    "type": "\"judge\" | \"post-run\" | \"system\"",
                    "required": false
                  },
                  {
                    "name": "engine",
                    "type": "string",
                    "required": false,
                    "description": "Picks the engine."
                  },
                  {
                    "name": "model",
                    "type": "string",
                    "required": false,
                    "description": "Pins a version such as jev-1.13.0. Thresholds are tuned per version."
                  },
                  {
                    "name": "abstainBelow",
                    "type": "number",
                    "required": false,
                    "description": "Confidence floor. Below it the result has abstained: true."
                  },
                  {
                    "name": "signal",
                    "type": "AbortSignal",
                    "required": false
                  }
                ]
              }
            ],
            "returns": "Record<questionId, Decision result>"
          },
          {
            "name": "decision_made",
            "kind": "event",
            "params": [
              {
                "name": "payload",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "decisionName",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "answers",
                    "type": "Record<questionId, Decision result>",
                    "required": true
                  },
                  {
                    "name": "chosen",
                    "type": "string",
                    "required": true,
                    "description": "The label the harness acts on."
                  },
                  {
                    "name": "confidenceSource",
                    "type": "\"native\" | \"self-reported\" | \"none\"",
                    "required": true
                  },
                  {
                    "name": "abstained",
                    "type": "boolean",
                    "required": true
                  },
                  {
                    "name": "engine",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "model",
                    "type": "string",
                    "required": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
