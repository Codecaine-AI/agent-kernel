    "b-dn-18": {
      "id": "b-dn-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every engine returns the same shape. "
        },
        {
          "insert": "confidenceSource",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is required, so no caller thresholds a self-reported number as if it were native. The example is a Jev verdict on a lint finding."
        }
      ],
      "children": []
