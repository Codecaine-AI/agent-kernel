    "b-dn-16": {
      "id": "b-dn-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The OpenAI Decisions API has no published endpoint, schema, model id, or pricing. Once those exist, it fits the same node contract as a second native engine. The BAML engine is the fallback and the escalation judge."
        }
      ],
      "children": []
    },
