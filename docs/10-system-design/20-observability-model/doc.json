    "b-20-observability-model-the-kernel-observability-2": {
      "id": "b-20-observability-model-the-kernel-observability-2",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The kernel observability model answers a simple question: what work ran, where did it belong, who spawned it, and what happened inside it?"
        }
      ],
      "children": []
    },
    "b-20-observability-model-divider-3": {
