        {
          "insert": "Identity Layers"
        }
      ],
      "children": []
    },
    "b-20-observability-model-appsessionid-is-host-a-7": {
      "id": "b-20-observability-model-appsessionid-is-host-a-7",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "appSessionId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is host-app correlation. It lets Spectre or another app link kernel rows back to app-owned workflow rows."
        }
      ],
      "children": []
    },
    "b-20-observability-model-containerid-is-kernel-8": {
      "id": "b-20-observability-model-containerid-is-kernel-8",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "containerId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is kernel grouping identity. Trace reads and viewer rendering should prefer containers because containers are the portable grouping model."
        }
      ],
      "children": []
    },
    "b-20-observability-model-pisessionid-links-even-9": {
      "id": "b-20-observability-model-pisessionid-links-even-9",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "piSessionId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " links events to the Pi session row after the tailer resolves the JSONL transport session id."
        }
      ],
      "children": []
    },
    "b-20-observability-model-runid-identifies-a-ker-10": {
      "id": "b-20-observability-model-runid-identifies-a-ker-10",
