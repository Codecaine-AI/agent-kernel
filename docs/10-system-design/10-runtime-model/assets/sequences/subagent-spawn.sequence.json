{
  "version": 1,
  "id": "subagent-spawn",
  "title": "Subagent spawn and steer",
  "participants": [
    {
      "id": "p1",
      "name": "parent",
      "kind": "participant",
      "label": "Parent agent"
    },
    {
      "id": "p2",
      "name": "tool",
      "kind": "participant",
      "label": "Spawner tool"
    },
    {
      "id": "p3",
      "name": "dispatch",
      "kind": "participant",
      "label": "dispatch handle"
    },
    {
      "id": "p4",
      "name": "manager",
      "kind": "participant",
      "label": "AgentManager"
    },
    {
      "id": "p5",
      "name": "child",
      "kind": "participant",
      "label": "Child run (spawnAgent)"
    },
    {
      "id": "p6",
      "name": "host",
      "kind": "actor",
      "label": "Host"
    }
  ],
  "items": [
    {
      "kind": "message",
      "id": "m1",
      "from": "p1",
      "to": "p2",
      "line": "sync",
      "text": "tool call (toolCallId)"
    },
    {
      "kind": "message",
      "id": "m2",
      "from": "p2",
      "to": "p3",
      "line": "sync",
      "text": "dispatch(agentName, prompt, opts)"
    },
    {
      "kind": "note",
      "id": "n1",
      "anchor": "p3",
      "side": "over",
      "text": "check spawns allowlist and catalog; capture parent RunContext identity"
    },
    {
      "kind": "fragment",
      "id": "f1",
      "op": "alt",
      "operands": [
        {
          "guard": "foreground",
          "items": [
            {
              "kind": "message",
              "id": "m3",
              "from": "p3",
              "to": "p4",
              "line": "sync",
              "text": "spawnAndWait(agentName, prompt, options)"
            },
            {
              "kind": "message",
              "id": "m4",
              "from": "p4",
              "to": "p5",
              "line": "sync",
              "text": "spawnAgent(trigger=parent-tool, parentRunId, containerId)"
            },
            {
              "kind": "message",
              "id": "m5",
              "from": "p5",
              "to": "p4",
              "line": "async",
              "text": "onSessionCreated(session)"
            },
            {
              "kind": "message",
              "id": "m6",
              "from": "p4",
              "to": "p1",
              "line": "async",
              "text": "append subagent link entry"
            },
            {
              "kind": "message",
              "id": "m7",
              "from": "p5",
              "to": "p4",
              "line": "return",
              "text": "responseText, aborted"
            },
            {
              "kind": "message",
              "id": "m8",
              "from": "p4",
              "to": "p3",
              "line": "return",
              "text": "AgentRecord"
            }
          ]
        },
        {
          "guard": "background",
          "items": [
            {
              "kind": "message",
              "id": "m9",
              "from": "p3",
              "to": "p4",
              "line": "sync",
              "text": "spawn(isBackground: true)"
            },
            {
              "kind": "fragment",
              "id": "f2",
              "op": "alt",
              "operands": [
                {
                  "guard": "running < maxBackgroundAgents",
                  "items": [
                    {
                      "kind": "message",
                      "id": "m10",
                      "from": "p4",
                      "to": "p5",
                      "line": "async",
                      "text": "startAgent: spawnAgent(...)"
                    }
                  ]
                },
                {
                  "guard": "limit reached",
                  "items": [
                    {
                      "kind": "note",
                      "id": "n2",
                      "anchor": "p4",
                      "side": "over",
                      "text": "FIFO queue; drains as background runs finish"
                    }
                  ]
                }
              ]
            },
            {
              "kind": "message",
              "id": "m11",
              "from": "p4",
              "to": "p3",
              "line": "return",
              "text": "agent id"
            }
          ]
        }
      ]
    },
    {
      "kind": "message",
      "id": "m12",
      "from": "p3",
      "to": "p2",
      "line": "return",
      "text": "AgentRecord or handle { id, agentName, status, done }"
    },
    {
      "kind": "message",
      "id": "m13",
      "from": "p2",
      "to": "p1",
      "line": "return",
      "text": "tool result"
    },
    {
      "kind": "fragment",
      "id": "f3",
      "op": "opt",
      "operands": [
        {
          "guard": "background child finishes",
          "items": [
            {
              "kind": "message",
              "id": "m14",
              "from": "p5",
              "to": "p4",
              "line": "return",
              "text": "final result"
            },
            {
              "kind": "message",
              "id": "m15",
              "from": "p4",
              "to": "p2",
              "line": "return",
              "text": "done resolves with the final record"
            }
          ]
        }
      ]
    },
    {
      "kind": "fragment",
      "id": "f4",
      "op": "opt",
      "operands": [
        {
          "guard": "host steers the child",
          "items": [
            {
              "kind": "message",
              "id": "m16",
              "from": "p6",
              "to": "p4",
              "line": "sync",
              "text": "agentManager.steer(id, message)"
            },
            {
              "kind": "fragment",
              "id": "f5",
              "op": "alt",
              "operands": [
                {
                  "guard": "child session exists",
                  "items": [
                    {
                      "kind": "message",
                      "id": "m17",
                      "from": "p4",
                      "to": "p5",
                      "line": "async",
                      "text": "session.steer(message)"
                    },
                    {
                      "kind": "note",
                      "id": "n3",
                      "anchor": "p4",
                      "side": "over",
                      "text": "run_steered delivery=delivered"
                    }
                  ]
                },
                {
                  "guard": "no session yet",
                  "items": [
                    {
                      "kind": "note",
                      "id": "n4",
                      "anchor": "p4",
                      "side": "over",
                      "text": "hold message, flush on session creation; run_steered delivery=queued"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "style": {}
}
