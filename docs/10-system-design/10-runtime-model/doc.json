    "b-10-runtime-model-the-runtime-model-is-int-2": {
      "id": "b-10-runtime-model-the-runtime-model-is-int-2",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The runtime model is intentionally layered. The kernel owns the shape of a run, but the host app supplies app state, agent catalogs, tool factories, database access, and domain behavior."
        }
      ],
      "children": []
    },
