        },
        {
          "insert": ", as the "
        },
        {
          "insert": "Identity Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/15-identity-model"
            }
          }
        },
        {
          "insert": " describes. The layout below is what any app harness reduces to."
        }
      ],
      "children": []
    },
