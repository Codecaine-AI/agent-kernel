    "b-70-harness-model-disallowedtools-enfo-36": {
      "id": "b-70-harness-model-disallowedtools-enfo-36",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "disallowedTools",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": enforced by blocking at "
        },
        {
          "insert": "tool_call",
          "attributes": {
