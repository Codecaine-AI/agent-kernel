    "b-70-harness-model-the-agent-kernel-repo-is-39": {
      "id": "b-70-harness-model-the-agent-kernel-repo-is-39",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The agent-kernel repo is itself a kernel: its generic catalog is the bundles' home, and "
        },
        {
          "insert": "packages/core-harness",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (:4860) is its service leg: health, kernel read API, catalog routes with writes allowed, and prompt-edit sessions so generic agents are editable from the Observatory's prompt lab. The harness reads "
        },
        {
          "insert": ".agent-kernel/kernel.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " but never writes it; the repo owns the manifest. When the sibling prompt-kit repo exists, its "
        },
        {
          "insert": "prompt-editor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " catalog joins the registry as an unlisted root: resolvable for prompt-edit spawns, absent from the listing. Model aliases cover "
        },
        {
          "insert": "prompt-editor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "context-editor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "docs-writer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Prompt-edit "
        },
        {
          "insert": "runs",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " record under the prompt-kit kernel (trace ownership: prompt editing is prompt-kit's domain); catalog writes stay on the core kernel."
        }
      ],
      "children": []
    },
