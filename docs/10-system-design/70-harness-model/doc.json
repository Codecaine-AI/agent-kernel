      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Ports are the ones the Observatory registry uses. canvas-agent defaults to :4820 in code; the registry launches it on :4822. The docs-system repo runs its own kernel service, "
        },
        {
          "insert": "docs-kernel",
          "attributes": {
            "code": true
