    "b-70-harness-model-tracing-outline": {
      "id": "b-70-harness-model-tracing-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "TUI session tracing",
            "steps": [
              {
                "text": "`/kernel` boot appends two markers to the pi transcript",
                "steps": [
                  {
                    "text": "`agent-kernel:session-binding` carries `containerId` and `runId` for transcript recovery.",
                    "kind": "note"
                  },
                  {
                    "text": "`agent-kernel:tui-session-meta` adds `agentName`, `cwd`, `kernelId`, `targetKernelRoot`, and `origin: \"tui\"`.",
                    "kind": "note"
                  },
                  {
                    "text": "The target kernel is the cwd repo's `.agent-kernel/`, else the core kernel's.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "pi persists the session JSONL",
                "steps": [
                  {
                    "text": "pi writes the file lazily. A session needs at least one model turn.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Operator runs `agent-kernel-tui-ingest`",
                "steps": [
                  {
                    "text": "Scan the pi sessions dir for files with a meta marker",
                    "steps": [
                      {
                        "text": "Plain pi sessions have no meta marker and are skipped.",
                        "kind": "note"
                      }
                    ]
                  },
                  {
                    "text": "Upsert the container: kind `session`, `metadata.origin: \"tui\"`"
                  },
                  {
                    "text": "Upsert the `pi_agent_sessions` and `agent_runs` rows",
                    "steps": [
                      {
                        "text": "The run gets trigger `operator` and status `done`.",
                        "kind": "note"
                      }
                    ]
                  },
                  {
                    "text": "Backfill the transcript's events into the owning kernel's `trace.db`",
                    "trace": true,
                    "steps": [
                      {
                        "text": "Event ids are deterministic, so a re-run inserts nothing new.",
                        "kind": "note"
                      }
                    ]
                  }
                ]
              },
              {
                "text": "Observatory shows the session with a `tui` badge",
                "steps": [
                  {
                    "text": "It sits beside the same kernel's app-harness runs.",
                    "kind": "note"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
