    "b-70-harness-model-runtime-constraint-tha-28": {
      "id": "b-70-harness-model-runtime-constraint-tha-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Runtime constraint that shapes everything:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " pi executes extensions, and therefore bundle sidecars, under Node via jiti, while the kernel ecosystem is bun-first. Anything the extension's import graph or a "
        },
        {
          "insert": "host:\"any\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " sidecar loads must survive a Node runtime. The import-graph rules that keep them Node-clean are implementation decisions. Doctor's host-portability check proves loadability under "
        },
        {
          "insert": "a",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " Node runtime. The final gate for tools sidecars is a boot through real pi."
        }
      ],
      "children": []
    },
