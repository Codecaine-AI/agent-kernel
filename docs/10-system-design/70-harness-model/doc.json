    "b-70-harness-model-a-kernel-is-the-unit-2": {
      "id": "b-70-harness-model-a-kernel-is-the-unit-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "kernel",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " is the unit the platform understands: manifest\n("
        },
        {
          "insert": ".agent-kernel/kernel.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") + catalog of bundles + "
        },
        {
          "insert": "trace.db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " + optional\nread API. A "
        },
        {
          "insert": "harness",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " is how sessions of a kernel's agents actually run.\nNothing about running kernels requires any particular harness."
        }
      ],
      "children": []
    },
