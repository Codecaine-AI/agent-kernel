      "id": "vm-kernel-gives-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A host mounts 2 kernel route factories inside its own HTTP service. Browser code reads traces through their routes and never opens the kernel database."
        }
      ],
      "children": []
    },
