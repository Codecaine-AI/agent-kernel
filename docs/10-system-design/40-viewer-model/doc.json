      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A container trace is one container subtree. It holds the root container, its descendant containers, their Pi sessions, their agent runs, and their events in timestamp order. Each container carries the 6 trace tags of an engine node attempt, such as "
        },
        {
          "insert": "engine",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "runId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
