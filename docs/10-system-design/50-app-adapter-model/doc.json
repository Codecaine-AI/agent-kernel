      "id": "b-50-app-adapter-model-an-app-adapter-turns-the-2",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An app adapter turns the generic kernel into a product-specific agent system. It should be explicit, testable, and mostly one-way: app code can depend on kernel packages, but kernel packages must not depend on app code."
        }
      ],
      "children": []
    },
