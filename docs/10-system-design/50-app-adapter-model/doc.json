        {
          "insert": "spec",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "plan",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "build",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "docs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or other Spectre workflow labels |\n| Custom loader | "
        },
        {
          "insert": "checkpoint-slice",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which reads Spectre plan/build state |\n| App state manager | "
        },
        {
          "insert": "SessionStateManager",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " passed through run context |\n| Domain tools | Spectre tools that mutate spec, plan, build, docs, projects, or asks |\n| Viewer plugin | Spectre session header and phase-specific panels |"
        }
      ],
