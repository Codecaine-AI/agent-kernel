    "b-50-app-adapter-model-agent-specific-private-t-24": {
      "id": "b-50-app-adapter-model-agent-specific-private-t-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Agent-specific private tools live in the bundle's tools sidecar beside the agent manifest ("
        },
        {
          "insert": "defineTools((pi, runtime) => …)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from "
        },
        {
          "insert": "@agent-kernel/kernel/agent-definition",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). The kernel binds the sidecar to the config "
        },
        {
          "insert": "toolRuntime",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at spawn time, and the registry harvests tool names at boot so they enter the allowlist automatically. Tools that many agents need come from the "
        },
        {
          "insert": "sharedTools",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " config slot instead. The runtime object is the app's callback surface: it is how sidecar tools reach app-owned state without the kernel learning app concepts."
        }
      ],
      "children": []
    },
