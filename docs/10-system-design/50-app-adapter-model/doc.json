        },
        {
          "insert": "examples/simple-research-kernel/src/server.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "packages/core-harness/src/kernel.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
