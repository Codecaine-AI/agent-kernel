        {
          "insert": "loaders",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " config slot as a "
        },
        {
          "insert": "{ kind, resolve(decl, ctx) }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " object. canvas-agent registers its own, such as "
        },
        {
          "insert": "styleGuideLoader",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "stateGrammarLoader",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
