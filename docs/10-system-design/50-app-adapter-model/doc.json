    "b-50-app-adapter-model-spectre-keeps-app-side-46": {
      "id": "b-50-app-adapter-model-spectre-keeps-app-side-46",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Spectre kept app-side: session rows and phase state, "
        },
        {
          "insert": "SessionStateManager",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the spec/plan/build/docs/intake/onboarding services, project/worktree/git behavior, the "
        },
        {
          "insert": "checkpoint-slice",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " loader, domain tools that write Spectre state, durable ask tables, and phase-specific UI panels. It consumed from the kernel: protocol event types and factories, kernel DB tables and query helpers, the spawn pipeline and run context, registry mechanics and prompt revisions, transcript recovery, the read API route factory, and the viewer packages."
        }
      ],
      "children": []
    },
    "b-50-app-adapter-model-spectre-compatibility-no-47": {
      "id": "b-50-app-adapter-model-spectre-compatibility-no-47",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Spectre Compatibility Note"
        }
      ],
      "children": []
    },
    "b-50-app-adapter-model-spectre-still-has-backen-48": {
      "id": "b-50-app-adapter-model-spectre-still-has-backen-48",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Spectre still has backend files named "
        },
        {
          "insert": "apps/backend/src/agent-kernel/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " because the kernel was extracted from that path. Spectre now runs its own copy of the kernel there. That copy is not the portable kernel source of truth."
        }
      ],
      "children": []
    },
    "b-50-app-adapter-model-a-new-app-should-not-rec-49": {
      "id": "b-50-app-adapter-model-a-new-app-should-not-rec-49",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A new app should not recreate the Spectre backend tree. It should create a small app-specific adapter and import kernel package exports directly. Start from a live adapter: canvas-agent for a product app, core-harness for a repo-owned kernel, or "
        },
        {
          "insert": "examples/simple-research-kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for the smallest working shape."
        }
      ],
      "children": []
    }
  }
}
