    "b-50-app-adapter-model-the-kernel-uses-containe-20": {
      "id": "b-50-app-adapter-model-the-kernel-uses-containe-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The kernel uses containers as the portable grouping primitive. The app keeps its own workflow tables wherever it likes and links them to kernel rows by container "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " + "
        },
        {
          "insert": "key",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ":"
        }
      ],
      "children": []
    },
    "b-50-app-adapter-model-ts-21": {
      "id": "b-50-app-adapter-model-ts-21",
      "type": "code",
      "props": {
        "language": "ts"
      },
      "text": [
        {
          "insert": "const container = await kernel.container({\n  kind: \"session\",\n  key: [appSessionRowId],\n  label: topic,\n  metadata: { app: \"my-app\" },\n});"
        }
      ],
      "children": []
    },
    "b-50-app-adapter-model-the-same-kind-and-key-al-22": {
      "id": "b-50-app-adapter-model-the-same-kind-and-key-al-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The same kind and key always resolve to the same container id, so the mapping needs no join table and the app never stores hashed grouping ids of its own. App workflow tables carry product semantics. Kernel rows carry runtime and observability."
        }
      ],
      "children": []
    },
