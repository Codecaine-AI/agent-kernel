    "b-50-app-adapter-model-reference-adapters-intro": {
      "id": "b-50-app-adapter-model-reference-adapters-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The live reference adapters are canvas-agent ("
        },
        {
          "insert": "../canvas/packages/canvas-agent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), prompt-kit-agent, and core-harness ("
        },
        {
          "insert": "packages/core-harness",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). The in-repo example is "
        },
        {
          "insert": "examples/simple-research-kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Spectre was the first host, and the kernel was extracted from it. Spectre now runs its own copy of the kernel; its column is history."
        }
      ],
      "children": []
    },
