    "b-15-identity-model-text-5": {
      "id": "b-15-identity-model-text-5",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "Container (kind + key, forms a tree)      the only grouping primitive\n  Agent session (Pi conversation)         promptHash, frozen system prompt\n    Run (message in -> response out)      trigger, status, usage rollup\n      Turn (one model call)               pi_turn_* trace events, no row"
        }
      ],
      "children": []
    },
    "b-15-identity-model-there-is-no-separate-ap-6": {
      "id": "b-15-identity-model-there-is-no-separate-ap-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no separate \"app session\" identity. An app session is a container of\n"
        },
        {
          "insert": "kind: \"session\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A worker slot is a container of "
        },
        {
          "insert": "kind: \"worker\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The kind\nvocabulary belongs to the host app; the container mechanics belong to the\nkernel."
        }
      ],
      "children": []
    },
