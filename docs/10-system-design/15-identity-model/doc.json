    "b-15-identity-model-containers-are-identifie-8": {
      "id": "b-15-identity-model-containers-are-identifie-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A host app asks for a container with "
        },
        {
          "insert": "kernel.container(spec)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The kernel derives the id from "
        },
        {
          "insert": "(kernelId, kind, key)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as "
        },
        {
          "insert": "uuidv5(kernelNamespace(kernelId), JSON.stringify([kind, ...key]))",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
