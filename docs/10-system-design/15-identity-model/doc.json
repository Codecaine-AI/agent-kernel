    "b-15-identity-model-a-run-is-one-processing-13": {
      "id": "b-15-identity-model-a-run-is-one-processing-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A run is one processing loop: a message goes in, the agent works, a response\ncomes out. A session holds many runs. The system prompt is frozen when the\nsession is created, so "
        },
        {
          "insert": "promptHash",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lives on the session; every run inherits\nit."
        }
      ],
      "children": []
    },
