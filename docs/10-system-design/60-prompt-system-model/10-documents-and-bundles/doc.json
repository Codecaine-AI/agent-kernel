    "b-10-dab-lead": {
      "id": "b-10-dab-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An agent is defined by data: an "
        },
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " manifest plus four sections, with the prompt stored as a typed document rather than code. This page covers the split between prompt-kit and the kernel, the bundle layout, the manifest and prompt document shapes, and what the manifest declares: variables, context, tools, and variants."
        }
      ],
      "children": []
    },
    "b-10-dab-the-split-prompt-kit-an-5": {
