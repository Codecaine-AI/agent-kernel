    "b-10-dab-the-manifest-is-data-va-13": {
      "id": "b-10-dab-the-manifest-is-data-va-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The manifest is data. The registry validates every "
        },
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " against the "
        },
        {
          "insert": "agent-kernel/agent-v1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " schema at boot, and an unknown field fails validation. "
        },
        {
          "insert": "defineAgent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the typed generator and validator for these files. Code sidecars attach by filename convention. Frontmatter and a separate "
        },
        {
          "insert": "config.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are not part of the model. The "
        },
        {
          "insert": "state.window",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " block takes a "
        },
        {
          "insert": "WindowPolicy",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", defined in "
        },
        {
