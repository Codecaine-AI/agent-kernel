    "b-10-dab-manifest-shape": {
      "id": "b-10-dab-manifest-shape",
      "type": "state-shape",
      "props": {
        "description": "The agent.json manifest.",
        "example": "{\n  \"$schema\": \"agent-kernel/agent-v1\",\n  \"name\": \"source-scout\",\n  \"description\": \"Investigates one focused angle, reads local evidence, and writes a durable research note.\",\n  \"model\": \"research-default\",\n  \"host\": \"any\",\n  \"thinking\": \"low\",\n  \"extensions\": false,\n  \"variables\": {\n    \"focus\": {\n      \"default\": \"\",\n      \"description\": \"Focus assigned by the coordinator.\"\n    },\n    \"researchMemoryDir\": {\n      \"default\": \"research-memory\",\n      \"description\": \"Directory inside the active research session where scout reports are stored.\"\n    }\n  },\n  \"variants\": {\n    \"deep\": {\n      \"thinking\": \"high\",\n      \"maxTurns\": 40,\n      \"displayLabel\": \"Source scout (deep)\"\n    }\n  },\n  \"state\": {\n    \"window\": {\n      \"strategy\": \"turns\",\n      \"maxTurns\": 8\n    }\n  }\n}",
        "fields": [
          {
            "name": "$schema",
            "type": "\"agent-kernel/agent-v1\"",
            "required": false
          },
          {
            "name": "name",
            "type": "string",
            "description": "Non-empty. Renames are file edits; manifest hot-reload rejects them."
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "model",
            "type": "string",
            "description": "Non-empty."
          },
          {
            "name": "host",
            "type": "\"app\" | \"any\"",
            "required": false
          },
          {
            "name": "thinking",
            "type": "string",
            "required": false
          },
          {
            "name": "maxTurns",
            "type": "number",
            "required": false
          },
          {
            "name": "coreTools",
            "type": "string[]",
            "required": false
          },
          {
            "name": "toolProfiles",
            "type": "string[]",
            "required": false
          },
          {
            "name": "disallowedTools",
            "type": "string[]",
            "required": false
          },
          {
            "name": "extensions",
            "type": "boolean | string[]",
            "required": false
          },
          {
            "name": "runInBackground",
            "type": "boolean",
            "required": false
          },
          {
            "name": "variables",
            "type": "Record<string, VariableDeclaration>",
            "required": false,
            "description": "Keyed by variable name. A variable is optional unless it sets required: true. An optional variable with no caller value and no default renders as an empty string.",
            "fields": [
              {
                "name": "default",
                "type": "unknown",
                "required": false,
                "description": "Value used when the caller provides none. A default satisfies required: true."
              },
              {
                "name": "optional",
                "type": "boolean",
                "required": false,
                "description": "Documentation flag with no runtime effect, because a variable is optional unless required is true. Boot validation rejects optional: true together with required: true."
              },
              {
                "name": "required",
                "type": "boolean",
                "required": false,
                "description": "true: the spawn fails with AgentVariableError code MISSING_REQUIRED_VARIABLES when the resolved value is undefined or null, which means no caller value and no default."
              },
              {
                "name": "description",
                "type": "string",
                "required": false
              }
            ]
          },
          {
            "name": "variants",
            "type": "Record<string, Variant>",
            "required": false,
            "description": "Keyed by variant name. The schema is closed: a variant cannot set prompt, context, tools, variables, or spawn declarations.",
            "fields": [
              {
                "name": "model",
                "type": "string",
                "required": false
              },
              {
                "name": "thinking",
                "type": "string",
                "required": false
              },
              {
                "name": "maxTurns",
                "type": "number",
                "required": false
              },
              {
                "name": "runInBackground",
                "type": "boolean",
                "required": false
              },
              {
                "name": "displayLabel",
                "type": "string",
                "required": false
              }
            ]
          },
          {
            "name": "state",
            "type": "object",
            "required": false,
            "fields": [
              {
                "name": "window",
                "type": "WindowPolicy",
                "required": false,
                "description": "Per-agent window policy (D85). Its presence activates the state extension, with or without a state.ts."
              }
            ]
          }
        ],
        "name": "AgentManifest",
        "source": {
          "path": "packages/kernel/src/agent-definition/agent-manifest-schema.ts",
          "symbol": "agentManifestJsonSchema"
        }
      },
      "children": []
