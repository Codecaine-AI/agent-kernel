    "b-10-dab-the-canonical-authored-p-16": {
      "id": "b-10-dab-the-canonical-authored-p-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canonical authored prompt artifact is the serialized "
        },
        {
          "insert": "PromptDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " JSON ("
        },
        {
          "insert": "prompt.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), not TypeScript code. Structural editing must persist, and edited documents cannot round-trip into hand-authored code. Scripts, generators, and tests that construct prompts use two plain constructors: "
        },
        {
          "insert": "definePrompt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for the document and "
        },
        {
          "insert": "createNode",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for a typed node ("
        },
        {
          "insert": "src/document/nodes/create-node.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). The registry loads the committed document. "
        },
        {
          "insert": "validatePrompt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the agent's declared variables performs, at boot and in the editor, the checks the type system used to perform."
        }
      ],
      "children": []
    },
