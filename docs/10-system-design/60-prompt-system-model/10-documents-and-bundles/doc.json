    "b-10-dab-prompt-document-shape": {
      "id": "b-10-dab-prompt-document-shape",
      "type": "state-shape",
      "props": {
        "description": "The serialized prompt.json document.",
        "example": "{\n  \"kind\": \"prompt\",\n  \"schemaVersion\": \"prompt-kit/v1\",\n  \"id\": \"sourceScoutPrompt\",\n  \"title\": \"Source Scout\",\n  \"archetype\": \"workflow\",\n  \"nodes\": [\n    {\n      \"type\": \"section\",\n      \"id\": \"node-section-1\",\n      \"tag\": \"purpose\",\n      \"children\": [\n        {\n          \"type\": \"paragraph\",\n          \"id\": \"node-paragraph-1\",\n          \"content\": [\n            \"You are a focused source scout working inside the Simple Research Kernel.\"\n          ]\n        }\n      ]\n    },\n    {\n      \"type\": \"section\",\n      \"id\": \"node-section-2\",\n      \"tag\": \"workflow\",\n      \"children\": [\n        {\n          \"type\": \"orderedList\",\n          \"id\": \"node-ordered-list-1\",\n          \"items\": [\n            {\n              \"type\": \"listItem\",\n              \"id\": \"node-list-item-1\",\n              \"content\": [\n                \"Read context.\"\n              ]\n            },\n            {\n              \"type\": \"listItem\",\n              \"id\": \"node-list-item-2\",\n              \"content\": [\n                \"Investigate \",\n                {\n                  \"type\": \"variable\",\n                  \"name\": \"focus\"\n                },\n                \" with available local evidence.\"\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
        "fields": [
          {
            "name": "kind",
            "type": "\"prompt\""
          },
          {
            "name": "schemaVersion",
            "type": "\"prompt-kit/v1\"",
            "description": "The migration hook."
          },
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "title",
            "type": "string",
            "required": false
          },
          {
            "name": "description",
            "type": "string",
            "required": false
          },
          {
            "name": "archetype",
            "type": "\"singleOutput\" | \"workflow\" | string",
            "required": false,
            "description": "Broad execution family; see Taxonomy."
          },
          {
            "name": "nodes",
            "type": "PromptBlockNode[]",
            "description": "Array order is the only ordering. Nodes carry no before, after, or priority hints.",
            "fields": [
              {
                "name": "type",
                "type": "\"section\" | \"paragraph\" | \"bulletList\" | \"orderedList\" | \"field\" | \"codeBlock\" | \"example\" | \"raw\" | \"contextUsage\""
              },
              {
                "name": "id",
                "type": "string",
                "required": false,
                "description": "Stable, and separate from the rendered XML tag. Supports replacement, insertion, diffing, and viewer selection."
              },
              {
                "name": "tag",
                "type": "string",
                "required": false,
                "description": "section only: the rendered XML tag."
              },
              {
                "name": "children",
                "type": "PromptBlockNode[]",
                "required": false,
                "description": "section and example: nested blocks."
              },
              {
                "name": "content",
                "type": "PromptInline[]",
                "required": false,
                "description": "Plain strings, { type: \"variable\", name } nodes, and { type: \"reference\", kind, name } nodes. Never raw {{placeholder}} strings."
              },
              {
                "name": "items",
                "type": "ListItemNode[]",
                "required": false,
                "description": "bulletList and orderedList. Each item holds content plus optional children, so a bullet can nest lists, paragraphs, or examples."
              },
              {
                "name": "contextId",
                "type": "string",
                "required": false,
                "description": "contextUsage only: the context block these instructions cover."
              }
            ]
          },
          {
            "name": "metadata",
            "type": "Record<string, unknown>",
            "required": false
          }
        ],
        "name": "PromptDocument",
        "source": {
          "path": "prompt-kit/packages/prompt-kit/src/document/nodes/types.ts",
          "symbol": "PromptDocument"
        }
      },
