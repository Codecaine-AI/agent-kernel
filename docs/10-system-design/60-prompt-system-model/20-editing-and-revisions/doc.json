    "b-20-ear-lead": {
      "id": "b-20-ear-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Prompts change through one path whatever the writer: a shared store that serializes saves, records a content-addressed revision, and tags it with its source. This page covers revisions, the shared store, revision sources, annotations and prompt-edit sessions, and manifest field editing."
        }
      ],
      "children": []
    },
    "b-20-ear-h-revisions": {
      "id": "b-20-ear-h-revisions",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Revisions"
        }
      ],
      "children": []
    },
    "b-20-ear-every-prompt-state-is-co-33": {
      "id": "b-20-ear-every-prompt-state-is-co-33",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every prompt state is content-addressed. The canonical document is hashed ("
        },
        {
          "insert": "\"pk1-\" + sha256(canonicalBytes)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and stored as a "
        },
        {
          "insert": "prompt_revisions",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row with the document and rendered text. Agent sessions record the hash at creation time, the system prompt is frozen at Pi session creation, so revisions bind to sessions, not runs. Each agent bundle also commits a derived rendered-markdown snapshot, enforced by test, so PR diffs show the rendered contract."
        }
      ],
      "children": []
    },
    "b-20-ear-h-shared-store": {
      "id": "b-20-ear-h-shared-store",
