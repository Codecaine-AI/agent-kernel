    "b-20-ear-revision-sources-205": {
      "id": "b-20-ear-revision-sources-205",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each revision records its source: "
        },
        {
          "insert": "registry-boot",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "lab-save",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "disk-sync",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "prompt-kit-mcp",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "migration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or "
        },
        {
          "insert": "agent-run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "packages/db/src/schema/prompt-revisions.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). When the kernel finds a prompt changed on disk out of band, it records the new hash as "
        },
        {
          "insert": "disk-sync",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". If the store's journal ("
        },
        {
          "insert": "readLatestPromptChange",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") shows the Prompt MCP made the change, the source is "
        },
        {
          "insert": "prompt-kit-mcp",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "agent-registry/register-prompt-revisions.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ")."
        }
