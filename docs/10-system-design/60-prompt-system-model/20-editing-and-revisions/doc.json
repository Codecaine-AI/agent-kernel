    "b-20-ear-editor-35": {
      "id": "b-20-ear-editor-35",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The editor, "
        },
        {
          "insert": "PromptInlineLab",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", is owned by prompt-kit and hosted in the agent viewer; prompt-kit's docs describe it at "
        },
        {
          "insert": "docs/10-system-design/60-editor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Reviewers leave annotations on prompt nodes, stored in "
        },
        {
          "insert": "annotations.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at the bundle root ("
        },
        {
          "insert": "agent-registry/annotation-sidecar.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). A prompt-edit session hands a set of annotations to the "
        },
        {
          "insert": "prompt-editor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " agent, which turns them into staged proposals ("
        },
        {
          "insert": "packages/kernel/src/prompt-edit-session/service.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Accepting or undoing a proposal saves a revision with source "
        },
        {
          "insert": "agent-run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Rejecting one discards it without a write."
        }
      ],
      "children": []
    },
