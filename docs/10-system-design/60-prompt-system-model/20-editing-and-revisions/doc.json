      "children": []
    },
    "b-20-ear-the-prompt-ui-reads-and-34": {
      "id": "b-20-ear-the-prompt-ui-reads-and-34",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The prompt UI reads and writes "
        },
        {
          "insert": "prompt.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directly. There is no codegen back into TypeScript. Every writer goes through the shared prompt store, "
        },
        {
          "insert": "createPromptStore",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from "
        },
        {
          "insert": "@codecaine-ai/prompt-kit-server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the lab through "
        },
        {
          "insert": "savePrompt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "packages/kernel/src/catalog-service.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the Prompt MCP directly. Both share one per-file lock, one change journal, and one compare-and-swap base."
        }
      ],
      "children": []
    },
