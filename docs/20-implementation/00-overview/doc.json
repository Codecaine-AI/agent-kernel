    "b-00-overview-text-7": {
      "id": "b-00-overview-text-7",
      "flavour": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "protocol\n  ^\n  |-- db\n  |-- tailer\n  |-- viewer-core\n        ^\n        |-- viewer-ui\n              ^\n              |-- viewer-shell\n\nkernel depends on protocol, db, and viewer-core for runtime/read contracts."
        }
      ],
      "children": []
    },
