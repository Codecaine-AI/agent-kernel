    "b-00-overview-text-5": {
      "id": "b-00-overview-text-5",
      "flavour": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "packages/\n  protocol/      Trace event envelope, event catalog, factories\n  db/            Kernel observability Drizzle schema and query helpers\n  kernel/        Kernel instance, spawn runtime, registry, context, subagents, read API\n  tailer/        Pi JSONL ingestion primitives\n  viewer-core/   Read API DTOs and trace span transforms\n  viewer-ui/     Trace tree and detail UI components\n  viewer-shell/  Mountable KernelTraceViewer shell"
        }
      ],
      "children": []
    },
