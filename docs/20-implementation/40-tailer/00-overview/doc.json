    "b-00-overview-component-purpose-5": {
      "id": "b-00-overview-component-purpose-5",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Component | Purpose |\n|---|---|\n| "
        },
        {
          "insert": "createTailerConfig",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Normalizes watch path, cursor path, batch sizes, retry limits, and health port |\n| "
        },
        {
          "insert": "EventMapper",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Maps Pi JSONL events to protocol "
        },
        {
          "insert": "TraceEvent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "s |\n| "
        },
        {
          "insert": "EventQueue",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Batches trace events and retries failed inserts |\n| "
        },
        {
          "insert": "CursorStore",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Tracks byte offsets and writes crash-recovery snapshots |\n| "
        },
        {
          "insert": "FileReader",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Reads appended JSONL lines from a file |\n| "
        },
        {
          "insert": "DirectoryWatcher",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Watches a directory tree and manages readers |\n| health route | Exposes queue, reader, pressure, DB, and uptime state |"
        }
      ],
