    "b-00-overview-the-queue-has-a-bounded-23": {
      "id": "b-00-overview-the-queue-has-a-bounded-23",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The queue has a bounded capacity. When full, callers can pause reading and resume once the queue drains."
        }
      ],
      "children": []
    },
    "b-00-overview-cursor-snapshots-let-the-24": {
      "id": "b-00-overview-cursor-snapshots-let-the-24",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Cursor snapshots let the tailer recover from process restarts. Re-read overlap is expected and handled by idempotent event insertion on the app side."
        }
      ],
