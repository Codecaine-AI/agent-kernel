    "b-00-overview-pi-jsonl-starts-with-pi-15": {
      "id": "b-00-overview-pi-jsonl-starts-with-pi-15",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Pi JSONL starts with Pi's own session id. The kernel mapper can hold events until it sees an app session binding marker. Once an app session id is known, pending events are stamped and released."
        }
      ],
      "children": []
    },
    "b-00-overview-the-marker-name-and-fiel-16": {
