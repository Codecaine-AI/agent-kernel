      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The marker name and field names are configurable through "
        },
        {
          "insert": "EventMapperOptions.sessionBinding",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Spectre can use its compatibility marker while new apps can use kernel-native marker names."
        }
      ],
      "children": []
