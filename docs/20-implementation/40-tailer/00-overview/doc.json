        {
          "insert": "@agent-kernel/tailer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " contains reusable Pi JSONL ingestion primitives. A host app wraps these primitives with DB inserts, watch paths, and app-specific marker names."
