    "b-10-sp-resume-d": {
      "id": "b-10-sp-resume-d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "resumeFromToolResult",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " reopens the stored Pi session under "
        },
        {
          "insert": "<piSessionsDir>/<containerId>/<agent>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", finds the assistant entry carrying the ask "
        },
        {
          "insert": "toolCall",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", branches there, and appends the real "
        },
        {
          "insert": "toolResult",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A real result already on the branch makes the append a no-op; the "
        },
        {
          "insert": "[awaiting user answer]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " placeholder does not count. "
        },
        {
          "insert": "session/turn-trigger.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " then starts the turn with a hidden custom message ("
        },
        {
          "insert": "kernel:ask-resume",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " by default) instead of a user prompt."
        }
      ],
      "children": []
    },
    "b-10-sp-resume-w": {
      "id": "b-10-sp-resume-w",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "The answer lands where the question was asked, so the call and its result stay a valid pair and the model continues its turn instead of reading a new user message. The duplicate check makes a retried resume safe."
        }
      ],
      "children": []
    },
