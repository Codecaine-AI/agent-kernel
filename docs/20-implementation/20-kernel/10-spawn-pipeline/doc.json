      ],
      "children": []
    },
    "b-10-sp-scoping-a": {
      "id": "b-10-sp-scoping-a",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "pi-session-factory/tool-scoping.ts",
