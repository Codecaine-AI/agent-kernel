        {
          "insert": "createAgentSession",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has loaded every extension factory, and narrows the session's active tools. The disallow list always gains "
        },
        {
          "insert": "SUBAGENT_TOOL_NAMES",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The allowlist filters non-extension tools. Extension tools (names containing "
        },
        {
          "insert": "__",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", such as "
        },
        {
          "insert": "mcp__",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tools) follow the manifest "
        },
        {
          "insert": "extensions",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " value: "
        },
        {
          "insert": "true",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keeps all, a string list keeps matches, "
        },
        {
          "insert": "false",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " drops all."
        }
      ],
      "children": []
    },
    "b-10-sp-scoping-w": {
      "id": "b-10-sp-scoping-w",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "Tools arrive from several factories: shared tools, private tools, the domain guard, and the state extension. Only the finished roster shows all of them, so one filter there covers every source. The subagent tool ban is D77; see "
        },
        {
          "insert": "Subagents",
          "attributes": {
            "reference": {
              "kind": "doc",
