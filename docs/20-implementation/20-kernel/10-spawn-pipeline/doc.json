            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "pi-session-factory/create-session.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and every future tool source: a new source registers normally and is scoped by this filter, never by its own allowlist check."
