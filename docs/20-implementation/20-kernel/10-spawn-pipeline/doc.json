    "b-10-sp-trace-w": {
      "id": "b-10-sp-trace-w",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "The trace observes the run; it is not a dependency of it. A throwing sink would turn a finished run into an error, or skip the status writes that close it."
        }
      ],
      "children": []
    },
