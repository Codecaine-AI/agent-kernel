          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "render-prompts-cli.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the catalog prompt-save path in "
        },
        {
          "insert": "catalog-service.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and any future code that writes a prompt render."
        }
      ],
      "children": []
    },
    "b-00-overview-createkernel-takes-con-15": {
      "id": "b-00-overview-createkernel-takes-con-15",
