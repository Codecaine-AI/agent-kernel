    "b-00-overview-rendered-prompt-markdown-11": {
      "id": "b-00-overview-rendered-prompt-markdown-11",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Rendered prompt markdown is a committed generated artifact with one byte format"
        }
      ],
      "children": []
    },
    "b-00-overview-decision-the-markdo-12": {
      "id": "b-00-overview-decision-the-markdo-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "The markdown render of a prompt ("
        },
        {
          "insert": "prompt.rendered.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in file form, "
        },
        {
          "insert": "prompt/system.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in folder form) is generated, committed, enforced by a snapshot test, and never hand-edited or parsed by the registry. The registry snapshot test and "
        },
        {
          "insert": "render-prompts-cli.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " write it through "
        },
        {
          "insert": "agent-registry/prompt-snapshot.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The catalog save route writes it through the prompt-kit-server store ("
        },
        {
          "insert": "createPromptStore().save()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "catalog-service.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and passes the kernel's "
        },
        {
          "insert": "RENDERED_SNAPSHOT_HEADER",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The store joins header and body the same way, so all three writers emit identical bytes."
        }
      ],
      "children": []
    },
    "b-00-overview-why-pr-diffs-show-t-13": {
      "id": "b-00-overview-why-pr-diffs-show-t-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " PR diffs show the behavioral contract in the format the model receives. The rejected alternatives (render-on-demand with no reviewable diff, or hand-maintained markdown that drifts from the canonical "
        },
        {
          "insert": "prompt.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") both break the \"prompt.json is the source of truth\" invariant."
        }
      ],
      "children": []
    },
    "b-00-overview-applies-to-package-14": {
      "id": "b-00-overview-applies-to-package-14",
