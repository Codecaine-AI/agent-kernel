    "b-20-ar-d98": {
      "id": "b-20-ar-d98",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Agent bundle sections are file-or-folder, resolved file-first (D98)"
        }
      ],
      "children": []
    },
    "b-20-ar-d98-d": {
      "id": "b-20-ar-d98-d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "Every bundle section has exactly two legal on-disk shapes: a single file ("
        },
        {
          "insert": "prompt.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "context.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "tools.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "state.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") or a folder with a fixed entry point ("
        },
        {
          "insert": "prompt/prompt.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "<kind>/index.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Resolution tries the file first, then the folder; when both exist the file wins silently, and "
        },
        {
          "insert": "doctor --catalog",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " reports the shadowed path. Discovery imports only the entry point; every other file in a section folder is invisible to it."
        }
      ],
      "children": []
    },
    "b-20-ar-d98-w": {
      "id": "b-20-ar-d98-w",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "Silent file-wins lets a migration leave a re-export shim at the old path without a boot error, while the doctor keeps shadowing visible. The rejected alternatives (one blessed shape or arbitrary per-section file names) either force catalog-wide migrations or make discovery guess."
        }
      ],
      "children": []
    },
    "b-20-ar-d98-a": {
      "id": "b-20-ar-d98-a",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "registry/bundle-layout.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; every agent bundle in every catalog, including sections and section kinds not yet written. A new section kind must define its file form, its folder entry point, and nothing else."
        }
      ],
      "children": []
    },
    "b-20-ar-harvest": {
      "id": "b-20-ar-harvest",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Sidecars attach by convention and are harvested at boot against a stub"
        }
      ],
      "children": []
    },
    "b-20-ar-harvest-d": {
      "id": "b-20-ar-harvest-d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "Context, tools, and state sidecars are discovered by filename convention, never declared in the manifest. The registry runs each tools sidecar at boot against a stub Pi object that records every "
        },
        {
          "insert": "registerTool",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " declaration (name, label, description, parameters) and the "
        },
        {
          "insert": "spawns",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " allowlist of each spawner tool; hooks registered through "
        },
        {
          "insert": "on",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " never run. The expanded tool allowlist and spawner map are therefore known and validated against the catalog without app dependencies. At spawn the same register function runs against the real session with the kernel's "
        },
        {
          "insert": "toolRuntime",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-20-ar-harvest-w": {
      "id": "b-20-ar-harvest-w",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "Declaring tool names in the manifest was rejected: it duplicates what the code already says and drifts. Boot-time harvest keeps "
        },
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pure data while still failing fast on unknown spawn targets."
        }
      ],
      "children": []
    },
    "b-20-ar-harvest-a": {
      "id": "b-20-ar-harvest-a",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "registry/harvest-private-tool-names.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", sidecar loading in "
        },
        {
          "insert": "registry/registry.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and every future sidecar kind. A new sidecar must be discoverable by convention and boot-checkable without a live runtime."
        }
      ],
      "children": []
    },
    "b-20-ar-aggregate": {
      "id": "b-20-ar-aggregate",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Boot collects every bundle error before failing"
        }
      ],
      "children": []
    },
    "b-20-ar-aggregate-d": {
      "id": "b-20-ar-aggregate-d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "buildRegistry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " loads every manifest under every root, turns each failure into a "
        },
        {
          "insert": "RegistryError",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " naming the bundle, then adds name collisions and unknown spawner targets. It throws one "
        },
        {
          "insert": "AggregateError",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when any error exists; it never stops at the first bad bundle and never returns a partial registry. The hot-reload paths ("
        },
        {
          "insert": "reloadAgentPrompt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "reloadAgentManifest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") run the same checks and swap the cached definition only after all pass; "
        },
        {
          "insert": "refreshAgentPromptFromDisk",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keeps the cached definition when the new file fails."
        }
      ],
      "children": []
    },
    "b-20-ar-aggregate-w": {
      "id": "b-20-ar-aggregate-w",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "One boot shows a catalog author every broken bundle. A partial registry would move the failure to the first spawn of the missing agent."
        }
      ],
      "children": []
    },
    "b-20-ar-aggregate-a": {
      "id": "b-20-ar-aggregate-a",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "registry/registry.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "registry/types.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and every future validation step: it reports through "
        },
        {
          "insert": "RegistryError",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into the same aggregate."
        }
      ],
      "children": []
    },
    "b-20-ar-shared": {
      "id": "b-20-ar-shared",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Boot and save validate a prompt with one function"
        }
      ],
      "children": []
    },
    "b-20-ar-shared-d": {
      "id": "b-20-ar-shared-d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "buildAgentPromptState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " validates a "
        },
        {
          "insert": "PromptDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " against its manifest and derives the rendered body, "
        },
        {
          "insert": "promptHash",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and warnings. Registry boot, the prompt reload paths, and the catalog save path all call it."
        }
      ],
      "children": []
    },
    "b-20-ar-shared-w": {
      "id": "b-20-ar-shared-w",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "A document a save accepts is exactly a document the next boot accepts. Two validators would drift, and a saved prompt could then fail the next boot."
        }
      ],
      "children": []
    },
    "b-20-ar-shared-a": {
      "id": "b-20-ar-shared-a",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "registry/registry.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "buildAgentPromptState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), the catalog save path in "
        },
        {
          "insert": "catalog-service.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and any future prompt write path."
        }
      ],
      "children": []
    },
    "b-20-ar-fixtures": {
      "id": "b-20-ar-fixtures",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Fixtures are preview data, read on demand"
        }
      ],
      "children": []
    },
    "b-20-ar-fixtures-d": {
      "id": "b-20-ar-fixtures-d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "State fixtures ("
        },
        {
          "insert": "state/fixtures/*.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", read by "
        },
        {
          "insert": "registry/state-fixtures.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and context fixtures ("
        },
        {
          "insert": "context/fixtures/*.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", read by "
        },
        {
          "insert": "context-fixtures.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") are discovered per request, not cached at boot. A file that fails to parse or has the wrong shape is skipped. The spawn pipeline never reads fixtures."
        }
      ],
      "children": []
    },
    "b-20-ar-fixtures-w": {
      "id": "b-20-ar-fixtures-w",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "Reading per request keeps a fixture edit visible without a restart. Skipping a bad file keeps one broken fixture from taking down the catalog detail route."
        }
      ],
      "children": []
    },
    "b-20-ar-fixtures-a": {
      "id": "b-20-ar-fixtures-a",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "registry/state-fixtures.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/kernel/src/context-fixtures.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and any future fixture kind."
        }
      ],
      "children": []
    },
    "b-20-ar-annotations": {
      "id": "b-20-ar-annotations",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Annotations live in a per-bundle sidecar and hold only live entries"
        }
      ],
      "children": []
    },
    "b-20-ar-annotations-d": {
      "id": "b-20-ar-annotations-d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "Each bundle keeps its prompt annotations in "
        },
        {
          "insert": "annotations.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " beside "
        },
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", for both prompt forms. Every read-check-write runs under an in-process mutex keyed on the sidecar path. Mutations take an optional "
        },
        {
          "insert": "expectedHash",
          "attributes": {
            "code": true
          }
        },
        {
