          "insert": ", "
        },
        {
          "insert": "mapper.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "reader.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "tui-ingest.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "tui-ingest-cli.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": future recovery features extend the invoked-tool surface rather than reintroducing a watcher."
        }
