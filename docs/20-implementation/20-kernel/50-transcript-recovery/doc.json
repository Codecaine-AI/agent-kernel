    "b-50-tr-tui-lead": {
      "id": "b-50-tr-tui-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "runTuiIngest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " imports "
        },
        {
          "insert": "/kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "-booted Pi TUI sessions into the kernel db that owns them. It creates the identity rows first, then reuses the backfill. Source: "
        },
        {
          "insert": "tui-ingest.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "tui-ingest-cli.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-50-tr-tui-outline": {
      "id": "b-50-tr-tui-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "`agent-kernel-tui-ingest` runs `runTuiIngest` over `~/.pi/agent/sessions`",
            "steps": [
              {
                "text": "`--sessions-dir` overrides the directory.",
                "kind": "note"
              },
              {
                "text": "Read each `.jsonl` file and pair its markers",
                "steps": [
                  {
                    "text": "Match each `agent-kernel:tui-session-meta` to an `agent-kernel:session-binding` by `containerId`"
                  },
                  {
                    "text": "A file with no meta marker is a plain Pi session and is skipped silently.",
                    "kind": "note"
                  },
                  {
                    "text": "A meta with no matching binding or no `targetKernelRoot` is skipped with a warning.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Group the file's boots by `targetKernelRoot`"
              },
              {
                "text": "Resolve the owning kernel db from `<root>/kernel.json`",
                "steps": [
                  {
                    "text": "`dbPath` defaults to `<root>/trace.db`. A relative path resolves against the root.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Log the target and stop when `--dry-run` is set"
              },
              {
                "text": "Open the db and ensure the schema",
                "steps": [
                  {
                    "text": "One handle per db serves every file that targets it.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "For each boot, upsert the identity rows backfill does not create",
                "steps": [
                  {
                    "text": "`upsertContainer` with kind `session` and appKey `[\"tui-session\", containerId]`"
                  },
                  {
                    "text": "`upsertPiAgentSession` keyed by the Pi session uuid"
                  },
                  {
                    "text": "`upsertAgentRun` with trigger `operator` when the marker carries a UUID `runId`"
                  }
                ]
              },
              {
                "text": "Run `runBackfill` over the file into the same db",
                "steps": [
                  {
                    "text": "The backfill sequence above runs unchanged, bound by the `agent-kernel:session-binding` marker.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Return `TuiIngestSummary` with upsert counts and inserted and skipped events"
              }
            ]
          }
        ]
      },
      "children": []
    },
