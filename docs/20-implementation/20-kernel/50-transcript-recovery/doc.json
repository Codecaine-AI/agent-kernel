    "b-50-transcript-recovery-recovery-lives-inside-th-5": {
      "id": "b-50-transcript-recovery-recovery-lives-inside-th-5",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Recovery lives inside the kernel package, beside the emitter"
        }
      ],
      "children": []
    },
    "b-50-transcript-recovery-decision-the-backfi-6": {
      "id": "b-50-transcript-recovery-decision-the-backfi-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The backfill mapper is a kernel module, co-located with the in-process emitter it must stay in parity with. Both derive ids and usage through "
        },
        {
          "insert": "@agent-kernel/protocol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The emitter's id-parity test imports "
        },
        {
          "insert": "EventMapper",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directly from "
        },
        {
          "insert": "../transcript-recovery",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as an intra-package drift guard."
        }
      ],
      "children": []
    },
    "b-50-transcript-recovery-why-the-two-emissio-7": {
      "id": "b-50-transcript-recovery-why-the-two-emissio-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The two emission paths must produce identical event ids or idempotent inserts stop deduplicating. A separate recovery package was rejected: it turns the parity requirement into a cross-repo contract that can drift between releases; co-location makes divergence a failing test in the same build."
        }
      ],
      "children": []
    },
    "b-50-transcript-recovery-applies-to-package-8": {
      "id": "b-50-transcript-recovery-applies-to-package-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "packages/kernel/src/transcript-recovery/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "packages/kernel/src/emitter/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": any change to either path's id derivation or event mapping must keep the parity test passing. New emission paths join the same package under the same guard."
        }
      ],
      "children": []
    },
    "b-50-transcript-recovery-a-recovery-tool-not-a-d-9": {
      "id": "b-50-transcript-recovery-a-recovery-tool-not-a-d-9",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "A recovery tool, not a daemon"
        }
      ],
      "children": []
    },
    "b-50-transcript-recovery-decision-recovery-i-10": {
      "id": "b-50-transcript-recovery-decision-recovery-i-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Recovery is an invoked operation: "
        },
        {
          "insert": "runBackfill(options)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " over a JSONL directory or file list (also accepting an already-open db handle for embedding), plus the CLIs. There is no directory watcher loop, cursor snapshot, or health port. Backfill itself creates no identity rows; "
        },
        {
          "insert": "runTuiIngest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " upserts them before it backfills, as outlined above."
        }
      ],
      "children": []
    },
    "b-50-transcript-recovery-accept-container-id": {
      "id": "b-50-transcript-recovery-accept-container-id",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "By default the mapper binds events only to UUID-shaped container ids. "
        },
        {
          "insert": "runBackfill",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " takes an "
        },
        {
          "insert": "acceptContainerId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " predicate to change that, and "
        },
        {
          "insert": "agent-kernel-backfill --any-container-id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " accepts every id."
        }
      ],
      "children": []
    },
    "b-50-transcript-recovery-why-the-primary-tra-11": {
      "id": "b-50-transcript-recovery-why-the-primary-tra-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The primary trace path is the in-process emitter. A watcher daemon duplicated it badly and needed its own lifecycle. A tool that reads the durable JSONL on demand covers disaster rebuild and import without a second always-on writer."
        }
      ],
      "children": []
    },
    "b-50-transcript-recovery-applies-to-package-12": {
      "id": "b-50-transcript-recovery-applies-to-package-12",
