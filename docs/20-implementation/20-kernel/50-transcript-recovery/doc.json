    "b-50-tr-backfill-lead": {
      "id": "b-50-tr-backfill-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A backfill run reads each file whole, maps it through a fresh "
        },
        {
          "insert": "EventMapper",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and inserts the result in batches. Source: "
        },
        {
          "insert": "backfill.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "reader.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "mapper.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Events still pending at the end of a file never saw a binding marker. The run drops them and adds a warning."
        }
      ],
      "children": []
    },
