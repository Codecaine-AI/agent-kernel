    "b-80-ch-d1-why": {
      "id": "b-80-ch-d1-why",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The repo owns the manifest as its own authoring surface. The app harnesses write theirs at boot; a boot here that did the same would replace the repo's authored roots and paths with computed ones."
        }
      ],
      "children": []
    },
    "b-80-ch-d1-applies": {
      "id": "b-80-ch-d1-applies",
