    "b-00-overview-the-viewer-implementatio-2": {
      "id": "b-00-overview-the-viewer-implementatio-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The viewer implementation spans three packages: "
        },
        {
          "insert": "packages/viewer-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (browser-safe data contracts and trace transforms), "
        },
        {
          "insert": "packages/viewer-ui",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (reusable React components), "
        },
        {
          "insert": "packages/viewer-shell",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (what a host mounts: composition surfaces and the shared style system, see "
        },
        {
          "insert": "Workspace and Shell",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "20-implementation/60-viewer/40-workspace-shell",
              "label": "Workspace and Shell"
            }
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
