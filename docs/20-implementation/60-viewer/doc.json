    "b-00-overview-decision-the-viewer-6": {
      "id": "b-00-overview-decision-the-viewer-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": The viewer is three packages (core (data), ui (components), shell (composition + style)), not one.\n"
        },
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": A host that only needs transforms and DTOs (a custom workflow UI, the observer) must not pull React components; a host composing "
        },
        {
          "insert": "viewer-ui",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directly must not inherit shell chrome. One merged package (the rejected alternative) makes every consumer carry everything.\n"
        },
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "packages/viewer-core/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/viewer-ui/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/viewer-shell/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and any future viewer code, which joins the layer matching what it exports."
        }
      ],
      "children": []
    },
    "b-00-overview-decision-viewer-co-7": {
      "id": "b-00-overview-decision-viewer-co-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "viewer-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is browser-safe by construction: it never imports Drizzle schema, "
        },
        {
          "insert": "@agent-kernel/db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or app DB types. Its API surface is path constants ("
        },
        {
          "insert": "KERNEL_TRACE_READ_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "KERNEL_CATALOG_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "KERNEL_PROMPT_EDIT_SESSION_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "KERNEL_OBSERVER_READ_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), DTOs ("
        },
        {
          "insert": "catalog-types.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the trace DTOs), and pure transforms ("
        },
        {
          "insert": "buildTraceSpans",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "diffPromptDocuments",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ").\n"
        },
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": Viewers read through APIs that return viewer-core DTOs (the design page's rule); a direct DB import (the rejected shortcut) would silently couple browser bundles to server schema.\n"
        },
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": everything under "
        },
        {
          "insert": "packages/viewer-core/src/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-00-overview-decision-viewer-ui-8": {
      "id": "b-00-overview-decision-viewer-ui-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": viewer-ui emits only Tailwind utilities; color "
        },
        {
          "insert": "values",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " are host theme tokens ("
        },
        {
          "insert": "--trace-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "--selection-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", band alphas as "
        },
        {
          "insert": "--band-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tokens) supplied by viewer-shell's style system, always with baked fallbacks.\n"
        },
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": Hosts must retheme without forking components. Baking values into viewer-ui (the rejected alternative) makes every theme change a package release. The token ownership crosses the package boundary on purpose.\n"
        },
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": all styled components in "
        },
        {
          "insert": "packages/viewer-ui/src/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", token emission in "
        },
        {
          "insert": "packages/viewer-shell/src/style/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-00-overview-decision-presentati-9": {
      "id": "b-00-overview-decision-presentati-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": Presentation knobs travel as options and CSS variables: "
        },
        {
          "insert": "SpanCardViewOptions",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is defined in viewer-ui ("
        },
        {
          "insert": "SpanCard.tsx",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and consumed by the shell; persistence and rail UI live only in viewer-shell.\n"
        },
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": The packages stay host-agnostic; per-host forks or prop-drilled preference plumbing (rejected) were how earlier hosts diverged. Where a surface has no prop path from the host (the detail panel's message cards), options reach it through "
        },
        {
          "insert": "icons/icon-settings.tsx",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rather than a new prop chain.\n"
        },
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": every user-tunable presentation option, current and future."
        }
      ],
      "children": []
    },
    "b-00-overview-viewer-core-structure-10": {
      "id": "b-00-overview-viewer-core-structure-10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "viewer-core structure"
        }
      ],
      "children": []
    },
    "b-00-overview-decision-one-canoni-11": {
      "id": "b-00-overview-decision-one-canoni-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": One canonical event sort, applied once at the top of "
        },
        {
          "insert": "buildTraceSpans",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "trace-builder/eventOrder.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "); every later stage sorts stably on "
        },
        {
          "insert": "startTime",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and never re-orders otherwise.\n"
        },
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": The ordering semantics (timestamp → turn number → causal rank → event id, see the design page) must hold at every zoom. Per-consumer re-sorting (the rejected alternative) lets each surface resolve same-millisecond ties differently.\n"
        },
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "trace-builder/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", any new transform stage."
        }
      ],
      "children": []
    },
    "b-00-overview-decision-all-span-f-12": {
      "id": "b-00-overview-decision-all-span-f-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": All span folding lives in "
        },
        {
          "insert": "trace-builder/nesting.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": turn ownership ("
        },
        {
          "insert": "groupSpansByTurn",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), user-message grouping ("
        },
        {
          "insert": "groupSpansByUserMessage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), usage folding, context-input grouping, and provisioning wrapping, as post-sort passes over the span list. It also holds "
        },
        {
          "insert": "findToolCallSpanByToolUseId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which "
        },
        {
          "insert": "buildTraceSpans",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " uses to attach a nested PI session to the tool-call span that spawned it. Spawner titling (\"Dispatch: <agents>\") is span attribution, not folding, and lives in "
        },
        {
          "insert": "trace-builder/spanAttributes.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ".\n"
        },
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": Nesting is causal, so it is only correct "
        },
        {
          "insert": "after",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " the canonical sort; scattering fold logic into per-span factories (rejected) would re-derive order locally and drift.\n"
        },
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "trace-builder/nesting.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and any future folding rule."
        }
      ],
      "children": []
    },
    "b-00-overview-decision-a-byte-exa-13": {
      "id": "b-00-overview-decision-a-byte-exa-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": A byte-exact characterization snapshot ("
        },
        {
          "insert": "trace-builder/__snapshots__/characterization.test.ts.snap",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") pins trace-builder output. Styling work must never move it. styling changes land in viewer-ui, viewer-shell, or the host, never in viewer-core semantics.\n"
        },
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": It separates semantic changes (rare, reviewed against the snapshot) from presentation churn (frequent). Trusting unit tests alone (the rejected alternative) let semantic drift ride in on styling PRs.\n"
        },
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": every change touching "
        },
        {
          "insert": "packages/viewer-core/src/trace-builder/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-00-overview-viewer-ui-structure-14": {
      "id": "b-00-overview-viewer-ui-structure-14",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "viewer-ui structure"
        }
      ],
