    "b-40-workspace-shell-governed-by-10-system-3": {
      "id": "b-40-workspace-shell-governed-by-10-system-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Governed by: "
        },
        {
          "insert": "Viewer Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-viewer-model"
            }
          }
        },
        {
          "insert": ". The workspace modes, the drill-in instrument, the style-system behavior, and the host seams ("
        },
        {
          "insert": "KernelTraceWorkspace",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "KernelTraceViewer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " props, "
        },
        {
          "insert": "KernelViewerPlugins",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "DetailBlockProvider",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") live there. This page records where the code sits and why."
        }
      ],
      "children": []
