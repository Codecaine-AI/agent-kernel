    "b-50-read-api-sessions-surface": {
      "id": "b-50-read-api-sessions-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "POST /catalog/agents/:name/edit-sessions",
            "kind": "action",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "body",
                "type": "object",
                "required": false,
                "fields": [
                  {
                    "name": "instruction",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "requestIds",
                    "type": "string[]",
                    "required": false,
                    "description": "Scopes the session. One id is a run-now, the queued set is apply; omitted works every open request. An empty array answers 400."
                  },
                  {
                    "name": "extraRequests",
                    "type": "array",
                    "required": false
                  },
                  {
                    "name": "sessionId",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "spawn",
                    "type": "boolean",
                    "required": false
                  }
                ]
              }
            ],
            "returns": "201 { state }",
            "description": "Answers 409 with a typed failure for agent-busy (the agent already has an open session) or empty-scope (no requested id is an open request)."
          },
          {
            "name": "GET /prompt-edit-sessions",
            "kind": "query",
            "returns": "{ sessions }"
          },
          {
            "name": "GET /prompt-edit-sessions/:id",
            "kind": "query",
            "params": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Prompt-edit session id."
              }
            ],
            "returns": "{ state }"
          },
          {
            "name": "GET /prompt-edit-sessions/:id/events",
            "kind": "event",
            "params": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Prompt-edit session id."
              }
            ],
            "returns": "text/event-stream of data: <json> frames",
            "description": "Sends one session-state snapshot on connect, then forwards every session and review event. The stream ends after session-disposed."
          },
          {
            "name": "POST /prompt-edit-sessions/:id/requests",
            "kind": "action",
            "params": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Prompt-edit session id."
              },
              {
                "name": "body",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "target",
                    "type": "prompt target",
                    "required": true
                  },
                  {
                    "name": "body",
                    "type": "string",
                    "required": true,
                    "description": "Non-empty."
                  },
                  {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "author",
                    "type": "string",
                    "required": false
                  }
                ]
              }
            ],
            "returns": "{ ok: true, request }",
            "description": "Adds a human request to a running session."
          },
          {
            "name": "POST /prompt-edit-sessions/:id/requests/:alias/accept",
            "kind": "action",
            "params": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Prompt-edit session id."
              },
              {
                "name": "alias",
                "type": "string",
                "required": true,
                "description": "Request alias within the session."
              }
            ],
            "returns": "{ ok, alias, transactionId, hash, annotation }",
            "description": "Applies the staged proposal as a prompt save. A moved live prompt answers 409 with { currentHash }; out-of-order accepts also answer 409."
          },
          {
            "name": "POST /prompt-edit-sessions/:id/requests/:alias/reject",
            "kind": "action",
            "params": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Prompt-edit session id."
              },
              {
                "name": "alias",
                "type": "string",
                "required": true,
                "description": "Request alias within the session."
              },
              {
                "name": "body",
                "type": "object",
                "required": false,
                "fields": [
                  {
                    "name": "note",
                    "type": "string",
                    "required": false
                  }
                ]
              }
            ],
            "returns": "{ ok, alias, transactionId, request, annotation }",
            "description": "Only the latest staged proposal can be rejected; others answer 409."
          },
          {
            "name": "POST /prompt-edit-sessions/:id/requests/:alias/undo",
            "kind": "action",
            "params": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Prompt-edit session id."
              },
              {
                "name": "alias",
                "type": "string",
                "required": true,
                "description": "Request alias within the session."
              }
            ],
            "returns": "{ ok, alias, transactionId, hash }",
            "description": "Only the latest applied proposal can be undone; others answer 409."
          },
          {
            "name": "POST /prompt-edit-sessions/:id/requests/:alias/replies",
            "kind": "action",
            "params": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Prompt-edit session id."
              },
              {
                "name": "alias",
                "type": "string",
                "required": true,
                "description": "Request alias within the session."
              },
              {
                "name": "body",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "body",
                    "type": "string",
                    "required": true,
                    "description": "Non-empty."
                  }
                ]
              }
            ],
            "returns": "{ ok: true, request }"
          },
          {
            "name": "DELETE /prompt-edit-sessions/:id",
            "kind": "action",
            "params": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Prompt-edit session id."
              }
            ],
            "returns": "{ ok: true }",
            "description": "Disposes the session and ends its event streams."
          }
        ],
        "title": "Prompt-Edit Session Routes"
      },
      "children": []
    },
    "b-50-read-api-decisions-6": {
      "id": "b-50-read-api-decisions-6",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Decisions"
        }
      ],
      "children": []
    },
    "b-50-read-api-route-paths-are-viewer-c-7": {
      "id": "b-50-read-api-route-paths-are-viewer-c-7",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Route paths are duplicated between kernel and viewer-core"
        }
      ],
      "children": []
    },
    "b-50-read-api-decision-every-url-8": {
      "id": "b-50-read-api-decision-every-url-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "@agent-kernel/viewer-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " defines the client side of each URL shape: "
        },
        {
          "insert": "KERNEL_TRACE_READ_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "KERNEL_CATALOG_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "KERNEL_PROMPT_EDIT_SESSION_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Viewer-ui fetchers use these constants. The kernel route factories write the same paths as template literals, because the kernel does not depend on the viewer ("
        },
        {
          "insert": "catalog-api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " header). Viewer-core also defines "
        },
        {
          "insert": "KERNEL_OBSERVER_READ_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for a cross-kernel observer plane. No server implements it yet."
        }
      ],
      "children": []
    },
    "b-50-read-api-why-the-routes-are-9": {
      "id": "b-50-read-api-why-the-routes-are-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Sharing the constants would make the kernel import a viewer package, which reverses the package dependency direction. The cost is that a path rename must change both sides by hand. "
        },
        {
          "insert": "packages/viewer-ui/src/kernel-route-parity.test.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " guards the pair. It builds the route factories over stub services, enumerates the registered routes, and fails when a method and path shape exists on one side only. The test lives in viewer-ui because that package already takes the kernel as a devDependency. Its one allowlisted gap is "
        },
        {
          "insert": "KERNEL_OBSERVER_READ_PATHS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-50-read-api-applies-to-package-10": {
      "id": "b-50-read-api-applies-to-package-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "packages/viewer-core/src/api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/kernel/src/read-api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "catalog-api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "catalog-annotations-api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "prompt-edit-session-api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and every future route. A new route adds its template literal in the kernel, its constant in viewer-core, and the constant's HTTP method in the parity test's method table."
        }
      ],
      "children": []
    },
    "b-50-read-api-routes-bind-to-a-service-11": {
      "id": "b-50-read-api-routes-bind-to-a-service-11",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Routes bind to a service contract, not to the database"
        }
      ],
      "children": []
    },
    "b-50-read-api-decision-the-route-12": {
      "id": "b-50-read-api-decision-the-route-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The route factory takes a "
        },
        {
          "insert": "KernelTraceReadService",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "getContainerTrace",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is required; "
        },
        {
          "insert": "listSessionContainers",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "getBlob",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "getRunTurnContext",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are optional, and each route answers 404 when its method is absent. The kernel ships the default container-backed implementation ("
        },
        {
          "insert": "kernel.readApiService",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", flushing pending trace writes before each read); the routes never import DB actions directly."
        }
      ],
      "children": []
    },
    "b-50-read-api-why-apps-with-custo-13": {
      "id": "b-50-read-api-why-apps-with-custo-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Apps with custom auth, tenancy, or payload shapes must be able to supply their own service without forking the routes. Binding routes straight to the db was rejected because it makes the route surface and the storage layer one unit."
        }
      ],
      "children": []
    },
    "b-50-read-api-applies-to-package-14": {
      "id": "b-50-read-api-applies-to-package-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "packages/kernel/src/read-api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "read-service.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and every future route: new reads extend the service contract, then the routes."
        }
      ],
      "children": []
    }
  }
}
