    "b-50-read-api-detail-shape": {
      "id": "b-50-read-api-detail-shape",
      "type": "state-shape",
      "props": {
        "example": "{\n  \"manifest\": {\n    \"$schema\": \"agent-kernel/agent-v1\",\n    \"name\": \"docs-writer\",\n    \"description\": \"Kicks off and executes documentation tasks in whatever repo the session runs in...\",\n    \"model\": \"docs-writer\",\n    \"thinking\": \"medium\",\n    \"maxTurns\": 40,\n    \"disallowedTools\": [\n      \"write\",\n      \"edit\"\n    ]\n  },\n  \"prompt\": {\n    \"kind\": \"prompt\",\n    \"schemaVersion\": \"prompt-kit/v1\",\n    \"id\": \"docsWriterPrompt\",\n    \"title\": \"Docs Writer\",\n    \"archetype\": \"workflow\",\n    \"nodes\": [\n      {\n        \"type\": \"section\",\n        \"id\": \"node-section-purpose\",\n        \"tag\": \"purpose\",\n        \"children\": []\n      }\n    ]\n  },\n  \"promptHash\": \"pk1-63801a3d2f2ec4c1b75e6650902114335130c83fc6c29d22a5a05ce079714a20\",\n  \"rendered\": \"<purpose>\\n    You are the docs writer: ...\\n</purpose>\",\n  \"declaredVariables\": [],\n  \"modelAliases\": [\n    \"prompt-editor\",\n    \"context-editor\",\n    \"docs-writer\"\n  ],\n  \"context\": {\n    \"modulePath\": \"/repo/catalog/docs-writer/context/index.ts\",\n    \"inputs\": [\n      {\n        \"loaderKind\": \"file\",\n        \"inputRef\": \"/repo/docs-system/docs/10-system-design/10-doc-standards/10-structure/doc.json\",\n        \"status\": \"ok\",\n        \"bytes\": 6120\n      }\n    ],\n    \"renderedContext\": \"<doc-standards>...</doc-standards>\"\n  },\n  \"fixtures\": [],\n  \"tools\": [\n    {\n      \"name\": \"docs_tree\",\n      \"label\": \"Docs tree\",\n      \"description\": \"List the repo's docs-system corpus: every doc node with its path, title, and block count. Start here to orient.\",\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"root\": {\n            \"type\": \"string\",\n            \"description\": \"docs root; default: nearest docs/ up-tree\"\n          }\n        }\n      }\n    }\n  ]\n}",
        "fields": [
          {
            "name": "manifest",
            "type": "Record<string, unknown>",
            "required": true,
            "description": "The bundle's agent.json."
          },
          {
            "name": "prompt",
            "type": "PromptDocument",
            "required": true
          },
          {
            "name": "promptHash",
            "type": "string",
            "required": true,
            "description": "pk1- canonical hash of prompt."
          },
          {
            "name": "rendered",
            "type": "string",
            "required": true,
            "description": "Rendered system prompt text."
          },
          {
            "name": "declaredVariables",
            "type": "string[]",
            "required": true
          },
          {
            "name": "modelAliases",
            "type": "string[]",
            "required": true,
            "description": "Keys of the kernel's models.aliases, offered as model suggestions."
          },
          {
            "name": "context",
            "type": "KernelCatalogContextPreview | null",
            "required": true,
            "description": "null when the bundle has no context sidecar.",
            "fields": [
              {
                "name": "modulePath",
                "type": "string | null",
                "required": true
              },
              {
                "name": "inputs",
                "type": "object[]",
                "required": true,
                "fields": [
                  {
                    "name": "loaderKind",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "inputRef",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "status",
                    "type": "\"ok\" | \"empty\" | \"error\"",
                    "required": true
                  },
                  {
