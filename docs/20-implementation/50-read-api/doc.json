    "b-50-read-api-catalog-surface": {
      "id": "b-50-read-api-catalog-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "GET /catalog/agents",
            "kind": "query",
            "returns": "{ agents: KernelCatalogAgentSummary[] }",
            "description": "Lists agents from listed catalog roots only. Each row carries name, description, pre-alias model, promptHash, and valid."
          },
          {
            "name": "GET /catalog/agents/:name",
            "kind": "query",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              }
            ],
            "returns": "KernelCatalogAgentDetail",
            "description": "Agents from unlisted roots still resolve here. Unknown agent answers 404."
          },
          {
            "name": "PUT /catalog/agents/:name/prompt",
            "kind": "action",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "body",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "document",
                    "type": "PromptDocument",
                    "required": true
                  },
                  {
                    "name": "expectedHash",
                    "type": "string",
                    "required": false,
                    "description": "Stale value answers 409 with { currentHash }."
                  }
                ]
              }
            ],
            "returns": "{ hash }",
            "description": "A bare PromptDocument body is also accepted. Invalid documents answer 400 with { errors }. A 500 with committed: true means the prompt file was written but a later step failed."
          },
          {
            "name": "PUT /catalog/agents/:name/manifest",
            "kind": "action",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "body",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "description",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "model",
                    "type": "string",
                    "required": false
                  }
                ]
              }
            ],
            "returns": "{ manifest }",
            "description": "Only description and model are editable; any other key answers 400."
          },
          {
            "name": "GET /catalog/agents/:name/revisions",
            "kind": "query",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              }
            ],
            "returns": "{ revisions: { hash, source, createdAt }[] }"
          },
          {
            "name": "GET /catalog/agents/:name/revisions/:hash/document",
            "kind": "query",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "hash",
                "type": "string",
                "required": true
              }
            ],
            "returns": "{ hash, createdAt, document: PromptDocument }"
          },
          {
            "name": "GET /catalog/agents/:name/revisions/:hash/stats",
            "kind": "query",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "hash",
                "type": "string",
                "required": true
              }
            ],
            "returns": "PromptRevisionStats: runs, totalTokens, avgTokens, cost",
            "description": "Aggregates runs whose sessions carry this prompt hash."
          },
          {
            "name": "GET /catalog/agents/:name/fixtures/:fixtureId/state-preview",
            "kind": "query",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "fixtureId",
                "type": "string",
                "required": true,
                "description": "A state/fixtures/<id>.json file in the bundle."
              }
            ],
            "returns": "{ fixtureId, source: \"state-module\" | \"fallback\", renderedState }",
            "description": "Renders through the bundle's state module when it has one, otherwise pretty-prints the fixture state."
          }
        ],
        "title": "Catalog Routes"
      },
      "children": []
    },
