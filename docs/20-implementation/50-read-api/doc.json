    "b-50-read-api-annotations-surface": {
      "id": "b-50-read-api-annotations-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "GET /catalog/agents/:name/annotations",
            "kind": "query",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              }
            ],
            "returns": "{ annotations, hash, dangling }",
            "description": "dangling lists targets that no longer resolve against the current prompt. A corrupt sidecar answers 422."
          },
          {
            "name": "POST /catalog/agents/:name/annotations",
            "kind": "action",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "body",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "target",
                    "type": "annotation target",
                    "required": true,
                    "description": "Must resolve against the current prompt, or the route answers 400."
                  },
                  {
                    "name": "body",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "intent",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "author",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "expectedHash",
                    "type": "string",
                    "required": false,
                    "description": "Sidecar hash the edit is based on; a stale value answers 409 with { currentHash }."
                  }
                ]
              }
            ],
            "returns": "{ ok, annotation, annotations, hash }"
          },
          {
            "name": "POST /catalog/agents/:name/annotations/prune",
            "kind": "action",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "body",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "resolvedOlderThan",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "expectedHash",
                    "type": "string",
                    "required": false,
                    "description": "Sidecar hash the edit is based on; a stale value answers 409 with { currentHash }."
                  }
                ]
              }
            ],
            "returns": "{ ok, removed, annotations, hash }",
            "description": "Compacts the sidecar by removing resolved annotations."
          },
          {
            "name": "POST /catalog/agents/:name/annotations/:id/replies",
            "kind": "action",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Annotation id."
              },
              {
                "name": "body",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "author",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "body",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "expectedHash",
                    "type": "string",
                    "required": false,
                    "description": "Sidecar hash the edit is based on; a stale value answers 409 with { currentHash }."
                  }
                ]
              }
            ],
            "returns": "{ ok, annotation, annotations, hash }"
          },
          {
            "name": "POST /catalog/agents/:name/annotations/:id/resolve",
            "kind": "action",
            "params": [
              {
                "name": "name",
                "type": "string",
                "required": true,
                "description": "Agent name from the catalog registry."
              },
              {
                "name": "id",
                "type": "string",
                "required": true,
                "description": "Annotation id."
              },
              {
                "name": "body",
                "type": "object",
                "required": true,
                "fields": [
                  {
                    "name": "status",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "resolution",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "expectedHash",
                    "type": "string",
                    "required": false,
                    "description": "Sidecar hash the edit is based on; a stale value answers 409 with { currentHash }."
                  }
                ]
              }
            ],
            "returns": "{ ok, annotation, annotations, hash }"
          },
          {
            "name": "POST /catalog/agents/:name/annotations/:id/agent-run",
            "kind": "action",
            "params": [
              {
                "name": "name",
