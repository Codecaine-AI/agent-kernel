    "b-50-read-api-routes-trace-link": {
      "id": "b-50-read-api-routes-trace-link",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Trace reads ("
        },
        {
          "insert": "read-api.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") serve the routes that Observability Model defines. One check runs before the service is called: a blob hash that is not "
        },
        {
          "insert": "b1-<sha256hex>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " answers 404."
        }
      ],
      "children": []
    },
    "b-50-read-api-routes-conventions": {
      "id": "b-50-read-api-routes-conventions",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every catalog, annotation, and prompt-edit mutation answers 403 unless "
        },
        {
          "insert": "allowWrites",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is set on the factory options or the service. Production harnesses ship read-only catalogs and leave it off. All routes answer 404 for an unknown agent, annotation, session, or request alias, and 400 with "
        },
        {
          "insert": "{ errors }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for invalid input. Paths below omit the prefix."
        }
      ],
      "children": []
    },
