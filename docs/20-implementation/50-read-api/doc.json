    "b-50-read-api-the-read-api-is-the-stab-2": {
      "id": "b-50-read-api-the-read-api-is-the-stab-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The read API is the stable route surface between kernel trace storage and viewer-core: Elysia route factories apps mount inside their own HTTP service, plus the kernel's default read service. Trace read routes, query limits, and the request-snapshot read path are design: "
        },
        {
          "insert": "Observability Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-observability-model",
              "label": "Observability Model"
            }
          }
        },
        {
          "insert": " § Read Surface. This page owns the catalog, annotation, and prompt-edit session routes."
        }
      ],
      "children": []
    },
