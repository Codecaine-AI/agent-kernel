            ]
          },
          {
            "name": "fixtures",
            "type": "{ id, label }[]",
            "required": true,
            "description": "Named state fixtures; empty when the bundle ships none."
          },
          {
            "name": "tools",
            "type": "KernelCatalogToolPreview[] | null",
