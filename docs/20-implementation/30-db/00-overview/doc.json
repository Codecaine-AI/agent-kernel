    "b-00-overview-containers-are-the-kerne-7": {
      "id": "b-00-overview-containers-are-the-kerne-7",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Containers are the kernel's portable grouping primitive. They carry label, status, parent container, working paths, phase label, phase vocabulary, metadata, and timestamps."
        }
      ],
      "children": []
    },
    "b-00-overview-apps-can-map-their-domai-8": {
      "id": "b-00-overview-apps-can-map-their-domai-8",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Apps can map their domain work units to containers without the kernel learning app workflow semantics."
        }
      ],
      "children": []
    },
