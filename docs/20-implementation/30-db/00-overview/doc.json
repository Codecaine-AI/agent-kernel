      "id": "b-00-overview-pi-agent-sessions-track-10",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Pi agent sessions track the durable Pi conversation identity for each agent. The table stores parent-child relationships, app-session correlation, container/phase labels, display labels, agent names, status, model, and timestamps."
        }
      ],
      "children": []
