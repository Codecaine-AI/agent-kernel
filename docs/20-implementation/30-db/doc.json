          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "packages/db/src/actions/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and every future schema change: tables and actions are written for SQLite alone."
        }
      ],
      "children": []
    },
