    "b-30-db-sqlite-first-actions-th-7": {
      "id": "b-30-db-sqlite-first-actions-th-7",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "SQLite is the only dialect"
        }
      ],
      "children": []
    },
    "b-30-db-decision-the-action-8": {
      "id": "b-30-db-decision-the-action-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " SQLite is the only store and the only schema dialect. "
        },
        {
          "insert": "schema/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is Drizzle SQLite, and the actions layer is typed against the Bun-SQLite Drizzle handle. There is no second-dialect schema and no dialect abstraction."
        }
      ],
      "children": []
    },
    "b-30-db-why-shared-plane-de-9": {
      "id": "b-30-db-why-shared-plane-de-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Each kernel owns one local database file, so the store needs no service process. A second dialect was rejected: no deployment uses one, and an unused copy of the schema still has to change with every table, column, and index."
        }
      ],
      "children": []
    },
    "b-30-db-applies-to-package-10": {
