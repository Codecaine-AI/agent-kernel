    "b-10-protocol-decision-determinis-8": {
      "id": "b-10-protocol-decision-determinis-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Deterministic event ids live in this package. "
        },
        {
          "insert": "deterministicEventId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " turns a seed string into a UUID-shaped id, and "
        },
        {
          "insert": "piEntryEventId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "liveFallbackEventId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " build their seeds and call it. Every emission path (the kernel's in-process emitter, the transcript-recovery mapper, and any future path) derives ids through these functions."
        }
      ],
      "children": []
    },
    "b-10-protocol-why-idempotent-inse-9": {
      "id": "b-10-protocol-why-idempotent-inse-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Idempotent inserts only dedupe if all paths derive identical ids from the same inputs. Per-path id generation (or random ids) was rejected because it makes live emission and backfill double-write the same session."
        }
      ],
      "children": []
    },
