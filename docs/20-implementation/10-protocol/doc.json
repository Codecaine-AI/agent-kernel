    },
    "b-10-protocol-factories-take-identity-11": {
      "id": "b-10-protocol-factories-take-identity-11",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Factories take identity first, as one "
        },
        {
          "insert": "ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " parameter"
        }
      ],
      "children": []
    },
    "b-10-protocol-decision-every-even-12": {
      "id": "b-10-protocol-decision-every-even-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Every event factory follows one signature convention: a "
        },
        {
          "insert": "TraceEventIds",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " object first ("
        },
        {
          "insert": "containerId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " required, "
        },
        {
          "insert": "runId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "/"
        },
        {
          "insert": "userId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "/"
        },
        {
          "insert": "agentId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "/"
        },
        {
          "insert": "piSessionUuid",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " optional), then the event's semantic arguments, then an optional "
        },
        {
          "insert": "opts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " object for span linkage and extras. Run lifecycle factories require "
        },
        {
          "insert": "runId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on "
        },
        {
          "insert": "ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-protocol-why-identity-thread-13": {
      "id": "b-10-protocol-why-identity-thread-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Identity threaded as loose positional arguments is how envelopes get mislabeled. One required parameter shape makes a missing "
        },
        {
          "insert": "containerId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " a type error. Applies-to is the point: new factories must keep the shape."
        }
      ],
      "children": []
    },
