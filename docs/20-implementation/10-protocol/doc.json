    "b-10-protocol-decision-the-kernel-16": {
      "id": "b-10-protocol-decision-the-kernel-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The kernel-authored message markers ("
        },
        {
          "insert": "kernel:context",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "kernel:state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and "
        },
        {
          "insert": "isKernelAuthoredMessage()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are protocol exports, even though only the kernel's state layer writes them. The image-elision marker follows the same rule. "
        },
        {
          "insert": "IMAGE_ELISION_MARKER_PREFIX",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "imageElisionMarkerText()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "isImageElisionMarker()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " define the text the kernel writes in place of an old image block, and the viewer detects it with the same helper."
        }
      ],
      "children": []
    },
    "b-10-protocol-why-the-marker-surv-17": {
      "id": "b-10-protocol-why-the-marker-surv-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The marker survives into request snapshots and is read back by the viewer (D99). It is part of the wire contract, and putting it in the kernel package would force viewer code to depend on the runtime. The rejected alternative was a kernel-local constant mirrored by hand in viewer code."
        }
      ],
      "children": []
    },
    "b-10-protocol-applies-to-package-18": {
