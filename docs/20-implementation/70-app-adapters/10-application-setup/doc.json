    "b-10-application-setup-a-host-application-is-th-2": {
      "id": "b-10-application-setup-a-host-application-is-th-2",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A host application is the product-specific layer above the kernel. It owns workflow state, domain tools, routing, product UI, and persistence choices while consuming "
        },
        {
          "insert": "@agent-kernel/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " packages for runtime, observability, trace reading, tailing, and viewer primitives."
        }
      ],
      "children": []
    },
