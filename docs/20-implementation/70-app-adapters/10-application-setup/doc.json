    "b-10-application-setup-the-app-adapter-creates-27": {
      "id": "b-10-application-setup-the-app-adapter-creates-27",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The app adapter creates the kernel instance and supplies the app-specific spawn implementation."
        }
      ],
      "children": []
    },
    "b-10-application-setup-ts-28": {
      "id": "b-10-application-setup-ts-28",
      "flavour": "code",
      "props": {
        "language": "ts"
      },
      "text": [
        {
          "insert": "import { createKernel, AgentManager } from \"@agent-kernel/kernel\";\n\nexport function createAppKernel() {\n  let kernel!: ReturnType<typeof createKernel>;\n\n  kernel = createKernel({\n    id: \"my-app\",\n    concurrency: {\n      maxBackgroundAgents: 4,\n    },\n    spawnAgent: async (name, prompt, ctx, opts) => {\n      return spawnAgentThroughMyApp(name, prompt, ctx, opts);\n    },\n    createAgentManager: ({ maxConcurrentBackgroundAgents }) =>\n      new AgentManager(undefined, maxConcurrentBackgroundAgents, undefined, {\n        spawnAgent: (name, prompt, ctx, opts) => kernel.spawnAgent(name, prompt, ctx, opts),\n      }),\n  });\n\n  return kernel;\n}"
        }
      ],
      "children": []
    },
    "b-10-application-setup-the-spawn-adapter-is-whe-29": {
