    "b-10-application-setup-ts-36": {
      "id": "b-10-application-setup-ts-36",
      "flavour": "code",
      "props": {
        "language": "ts"
      },
      "text": [
        {
          "insert": "import { createDefaultCatalog } from \"@agent-kernel/kernel/context/loaders\";\n\nconst catalog = createDefaultCatalog();\n\ncatalog.register({\n  kind: \"my-workflow-slice\",\n  async load(input, ctx) {\n    const state = await loadMyWorkflowState(ctx.appSessionId);\n    return {\n      status: \"ok\",\n      content: JSON.stringify(state, null, 2),\n      bytes: 0,\n      fromCache: false,\n    };\n  },\n});"
        }
      ],
      "children": []
    },
