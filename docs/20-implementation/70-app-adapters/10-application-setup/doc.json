      "props": {},
      "text": [
        {
          "insert": "Spectre has an "
        },
        {
          "insert": "apps/backend/src/agent-kernel/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directory because it was the original extraction site. In Spectre today, many files in that directory are compatibility wrappers or adapter files that forward to "
        },
        {
          "insert": "@agent-kernel/kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " while preserving old import paths."
