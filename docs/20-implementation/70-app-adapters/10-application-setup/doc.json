      "id": "b-10-application-setup-the-dependency-direction-6",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The dependency direction is one-way. App code imports kernel packages. Kernel packages must not import app code or know app concepts."
        }
