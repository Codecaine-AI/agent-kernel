    "b-70-app-adapters-decision-a-new-host-11": {
      "id": "b-70-app-adapters-decision-a-new-host-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " A new host app builds a small adapter surface with app-owned names (a kernel-instance module ("
        },
        {
          "insert": "createKernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from one config object), a container-mapping seam, and an agent catalog directory) importing kernel package exports directly. It never copies Spectre's "
        },
        {
          "insert": "apps/backend/src/agent-kernel/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tree."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-why-that-spectre-tr-12": {
      "id": "b-70-app-adapters-why-that-spectre-tr-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " That Spectre tree is the extraction site: adapter code plus transitional re-export shims preserving old import paths, not kernel source. Copying it would propagate compatibility debt into a clean app. "
        },
        {
          "insert": "examples/simple-research-kernel/src",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (server + store + agent-catalog) is the shape to copy instead."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-applies-to-every-fu-13": {
      "id": "b-70-app-adapters-applies-to-every-fu-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " every future host app; "
        },
        {
          "insert": "examples/simple-research-kernel/src",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as the reference."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-tool-placement-14": {
      "id": "b-70-app-adapters-tool-placement-14",
      "type": "heading",
      "props": {
