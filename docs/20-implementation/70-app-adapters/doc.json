        {
          "insert": "packages/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "scripts/check-package-boundaries.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and all host-app adapter code, including apps not yet written."
        }
      ],
      "children": []
    },
