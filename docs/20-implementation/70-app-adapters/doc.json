    "b-70-app-adapters-decision-tools-for-15": {
      "id": "b-70-app-adapters-decision-tools-for-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Tools for one agent live in that bundle's tools sidecar beside its manifest; tools shared across agents come from the "
        },
        {
          "insert": "sharedTools",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " config slot; app capabilities reach sidecars only through the config "
        },
        {
          "insert": "toolRuntime",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-why-colocated-sidec-16": {
      "id": "b-70-app-adapters-why-colocated-sidec-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Colocated sidecars keep implementation, prompt, and manifest together, and the registry harvests tool names at boot so allowlists stay automatic. The rejected alternative (a central app tool registry) separates a tool from the one agent that uses it and hides the allowlist wiring."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-applies-to-host-app-17": {
      "id": "b-70-app-adapters-applies-to-host-app-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " host-app agent catalogs, "
        },
        {
          "insert": "catalog/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "examples/simple-research-kernel/src/agent-catalog/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-loader-placement-18": {
      "id": "b-70-app-adapters-loader-placement-18",
