    "b-70-app-adapters-decision-the-packag-7": {
      "id": "b-70-app-adapters-decision-the-packag-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Kernel packages stay app-neutral. App code imports "
        },
        {
          "insert": "@agent-kernel/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exports; kernel packages never import app code, reference app paths, or carry app loader/tool names. "
        },
        {
          "insert": "scripts/check-package-boundaries.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " enforces part of this rule: it scans "
        },
        {
          "insert": "packages/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for forbidden app-specific strings ("
        },
        {
          "insert": "@spectre/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "apps/backend",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "apps/frontend",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "apps/data-backend",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "apps/tailer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "SessionStateManager",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "checkpoint-slice",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": ".spectre",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and fails on any match. It does not check the import graph between packages. A host app should mirror the check with its own forbidden strings."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-why-the-alternative-8": {
      "id": "b-70-app-adapters-why-the-alternative-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The alternative (kernel-side hooks or registries that know app concepts) is how the original extraction site got entangled. A one-way graph keeps every kernel package portable to the next host without edits."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-applies-to-package-9": {
      "id": "b-70-app-adapters-applies-to-package-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to:",
          "attributes": {
            "bold": true
          }
