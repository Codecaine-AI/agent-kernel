    "b-70-app-adapters-decision-a-loader-t-19": {
      "id": "b-70-app-adapters-decision-a-loader-t-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " A loader that reads app tables, app artifacts, or product workflow state lives in the host app and enters through the "
        },
        {
          "insert": "loaders",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " config slot. The kernel's own loader catalog stays generic."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-why-app-aware-loade-20": {
      "id": "b-70-app-adapters-why-app-aware-loade-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " App-aware loaders inside the kernel package would put app knowledge on the wrong side of the dependency direction. The slot keeps the extension point without the entanglement."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-applies-to-host-app-21": {
      "id": "b-70-app-adapters-applies-to-host-app-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " host-app adapters (Spectre's "
        },
        {
          "insert": "checkpoint-slice",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the example's working-memory loader), "
        },
        {
          "insert": "packages/kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "'s loader catalog."
        }
