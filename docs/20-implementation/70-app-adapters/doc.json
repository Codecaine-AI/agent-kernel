    "b-70-app-adapters-why-folding-either-28": {
      "id": "b-70-app-adapters-why-folding-either-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Folding either leg into "
        },
        {
          "insert": "@agent-kernel/kernel",
          "attributes": {
