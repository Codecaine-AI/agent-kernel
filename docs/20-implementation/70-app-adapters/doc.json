    "b-70-app-adapters-decision-the-tui-ex-23": {
      "id": "b-70-app-adapters-decision-the-tui-ex-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The TUI extension's import graph and every "
        },
        {
          "insert": "host:\"any\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " sidecar import deep, dependency-light kernel subpaths (e.g. "
        },
        {
          "insert": "@agent-kernel/kernel/agent-registry/registry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") (never package barrels) and use no bun-only APIs ("
        },
        {
          "insert": "bun:sqlite",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Bun.*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "import.meta.dir",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-why-pi-runs-extensi-24": {
      "id": "b-70-app-adapters-why-pi-runs-extensi-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " pi runs extensions and sidecars under Node via jiti. Barrel imports have broken real boots: the agent-registry barrel reaches "
        },
        {
          "insert": "@agent-kernel/db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and therefore "
        },
        {
          "insert": "bun:sqlite",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and a barrel pulling an incompatible typebox flavor at module load killed the extension. The rejected alternative (importing barrels and shimming the runtime) hides the breakage until a pi boot."
        }
      ],
      "children": []
    },
    "b-70-app-adapters-applies-to-package-25": {
      "id": "b-70-app-adapters-applies-to-package-25",
      "type": "paragraph",
      "props": {},
