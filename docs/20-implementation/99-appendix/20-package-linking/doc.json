    "b-20-package-linking-mechanism-when-to-us-23": {
      "id": "b-20-package-linking-mechanism-when-to-us-23",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Mechanism | When To Use |\n|---|---|\n| Git submodule workspace | Best next step while APIs are still changing and both repos need local development |\n| Private registry packages | Best later step after the package API stabilizes |\n| Git dependency | Possible bridge, but less ergonomic for multi-package workspace development |"
        }
      ],
      "children": []
    },
