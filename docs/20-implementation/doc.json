        {
          "insert": "system design",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design",
              "label": "system design"
            }
          }
        },
        {
          "insert": "; dev commands live in the repo "
        },
        {
          "insert": "README.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
