    "b-00-overview-decision-packages-l-8": {
      "id": "b-00-overview-decision-packages-l-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Packages layer one way. "
        },
        {
          "insert": "protocol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the base and has no workspace dependencies. "
        },
        {
          "insert": "db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " depends on "
        },
        {
          "insert": "protocol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " depends on "
        },
        {
          "insert": "protocol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the external "
        },
        {
          "insert": "prompt-kit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "prompt-kit-server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "core-harness",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " depends on "
        },
        {
          "insert": "kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; "
        },
        {
          "insert": "tui",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " depends on "
        },
        {
          "insert": "kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". On the viewer side, "
        },
        {
          "insert": "viewer-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " depends on "
        },
        {
          "insert": "protocol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "prompt-kit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; "
        },
        {
          "insert": "viewer-ui",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on "
        },
        {
          "insert": "viewer-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "protocol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "prompt-kit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; "
        },
        {
          "insert": "viewer-shell",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on "
        },
        {
          "insert": "viewer-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "viewer-ui",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The kernel depends on no viewer package: where it serves a viewer contract, it duplicates the route paths and matches the DTO shapes structurally instead of importing them. No kernel package imports Spectre packages, Spectre paths, or Spectre naming; apps consume the kernel through package exports and adapters, never through package internals."
        }
      ],
      "children": []
