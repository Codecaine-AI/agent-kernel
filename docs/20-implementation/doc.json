    "b-00-overview-decision-while-pack-16": {
      "id": "b-00-overview-decision-while-pack-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " While package contracts are unstable, consumption is linked workspace source (submodule or meta-workspace member) with "
        },
        {
          "insert": "workspace:*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Published, version-pinned registry packages replace "
        },
        {
          "insert": "workspace:*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " only after the APIs stabilize."
        }
      ],
      "children": []
    },
    "b-00-overview-why-registry-pinnin-17": {
      "id": "b-00-overview-why-registry-pinnin-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Registry pinning during churn forces a publish per cross-repo change; linked source keeps multi-repo development live. Publishing to a private registry now was considered and rejected."
        }
      ],
      "children": []
    },
