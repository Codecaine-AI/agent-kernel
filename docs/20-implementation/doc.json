    "b-00-overview-why-the-protocol-is-9": {
      "id": "b-00-overview-why-the-protocol-is-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The protocol is the shared vocabulary, so everything meets there; one-way layering keeps the viewer embeddable without the runtime and the kernel free of UI dependencies. The rejected alternative (letting the kernel reach into viewer packages, or hosts import internals directly) is how Spectre's original entanglement happened and what the extraction undid."
        }
      ],
      "children": []
    },
    "b-00-overview-applies-to-package-10": {
      "id": "b-00-overview-applies-to-package-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "packages/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and any future package added to the workspace. "
        },
        {
          "insert": "scripts/check-package-boundaries.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " enforces only the Spectre rule: it fails when package source contains an app-specific string such as "
        },
        {
          "insert": "@spectre/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "apps/backend",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". No script checks the package graph, so review each "
        },
        {
          "insert": "package.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " dependency against this layering."
        }
      ],
      "children": []
    },
