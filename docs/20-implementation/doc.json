    "b-00-overview-decision-this-repos-12": {
      "id": "b-00-overview-decision-this-repos-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " This repository is the sole source of the "
        },
        {
          "insert": "@agent-kernel/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " packages. Consumers link them as workspace members (Core's "
        },
        {
          "insert": "agent-kernel/packages/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus "
        },
        {
          "insert": "examples/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") or as a git-submodule workspace (Spectre's "
        },
        {
          "insert": "packages/pi-agent-kernel/packages/*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") with "
        },
        {
          "insert": "workspace:*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " dependencies. No consumer keeps local copies."
        }
      ],
      "children": []
    },
    "b-00-overview-why-the-extraction-13": {
      "id": "b-00-overview-why-the-extraction-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The extraction left Spectre with a parallel in-app copy of every package; two copies under one name drift immediately, and the boundary tests guard only one of them. Vendoring per host (the rejected alternative) is how Spectre's compat-shim debt accumulated."
        }
      ],
      "children": []
    },
    "b-00-overview-applies-to-package-14": {
      "id": "b-00-overview-applies-to-package-14",
