        },
        {
          "insert": ", and "
        },
        {
          "insert": "/state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", never the package barrel or the "
        },
        {
          "insert": "agent-registry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " barrel. "
        },
        {
          "insert": "session-binding.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keeps "
        },
        {
          "insert": "SESSION_BINDING_CUSTOM_TYPE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as a string literal that must match the kernel's "
