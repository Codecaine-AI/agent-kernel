    "b-85-tui-d5-decision": {
      "id": "b-85-tui-d5-decision",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "registerAgentCommands",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " registers one "
        },
        {
          "insert": "before_agent_start",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " handler and one "
        },
        {
          "insert": "tool_call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " handler at extension load. Both read closure state that each boot replaces: the cached system prompt and the active manifest's "
        },
        {
          "insert": "disallowedTools",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which the "
        },
        {
          "insert": "tool_call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " handler blocks with a visible reason. "
        },
        {
          "insert": "bindBundleTools",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "tools.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " adds a "
        },
        {
          "insert": "tool_call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " handler per bind that blocks the bundle's spawner tools. Tools registered by an earlier boot stay registered for the session."
        }
      ],
      "children": []
    },
    "b-85-tui-d5-why": {
      "id": "b-85-tui-d5-why",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Interactive pi sessions keep their built-in tools because the spawn pipeline's tool scoping never runs, so blocking the call is the only enforcement point. Spawner tools need the spawn pipeline's dispatch handle, which a standalone session does not have."
        }
      ],
      "children": []
    },
