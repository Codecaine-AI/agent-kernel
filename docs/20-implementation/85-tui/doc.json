    "b-85-tui-d1-why": {
      "id": "b-85-tui-d1-why",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The "
        },
        {
          "insert": "agent-registry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " barrel re-exports "
        },
        {
          "insert": "register-prompt-revisions.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", whose "
        },
        {
          "insert": "@agent-kernel/db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " import evaluates "
        },
        {
          "insert": "bun:sqlite",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at load, and pi's Node runtime cannot load it. Copying one constant costs less than pulling the barrel. "
        },
        {
          "insert": "App Adapters",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "20-implementation/70-app-adapters",
              "label": "App Adapters"
            }
          }
        },
        {
          "insert": " records the same rule for "
        },
        {
          "insert": "host:\"any\"",
          "attributes": {
            "code": true
