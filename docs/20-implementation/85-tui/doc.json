    },
    "b-85-tui-d4-decision": {
      "id": "b-85-tui-d4-decision",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "loadCatalog",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " builds one registry for the project layer (the cwd-walk "
        },
        {
          "insert": "kernel.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "catalogRoots",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and one for the generic layer ("
        },
        {
          "insert": "catalog/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", located from the package's own path). Resolution walks the layers in order, and a loadable bundle in any layer wins over an app-hosted or failed bundle of the same name in an earlier one. Inside a layer, "
        },
        {
          "insert": "buildLayer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " classifies "
        },
        {
          "insert": "host",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from the manifest JSON before any sidecar is evaluated, then excludes failing "
        },
        {
          "insert": "host:\"any\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " bundles and rebuilds until the registry builds."
        }
      ],
      "children": []
    },
    "b-85-tui-d4-why": {
      "id": "b-85-tui-d4-why",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "buildRegistry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rejects same-name manifests within one call and fails all-or-nothing. A single registry over both layers would turn every deliberate shadow into a collision and one broken bundle into an empty catalog."
        }
      ],
      "children": []
    },
