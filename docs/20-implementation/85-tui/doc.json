    },
    "b-85-tui-d3-decision": {
      "id": "b-85-tui-d3-decision",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "boot.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rebuilds prompt variable substitution (from "
        },
        {
          "insert": "spawn-pipeline/system-prompt-resolver/resolve-system-prompt.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and the state render (from "
        },
        {
          "insert": "buildStatePreview",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "catalog-service.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") out of exported primitives instead of importing the spawn pipeline. It degrades instead of failing: an unresolved placeholder, which the original resolver throws on, a failed context resolver, and a failed state render each become a warning in the boot notice."
        }
      ],
      "children": []
    },
    "b-85-tui-d3-why": {
      "id": "b-85-tui-d3-why",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The spawn pipeline imports the database, so it cannot load under Node. An interactive session should still start with a partial prompt rather than refuse to boot."
        }
      ],
      "children": []
    },
