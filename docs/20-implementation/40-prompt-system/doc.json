    "b-40-prompt-system-why-the-markers-sur-24": {
      "id": "b-40-prompt-system-why-the-markers-sur-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The markers survive into snapshot blobs the viewer reads back, so\ndefining them in the kernel would leave the viewer re-deriving the rule:\nthe producer/consumer drift design D99 exists to prevent."
        }
      ],
      "children": []
