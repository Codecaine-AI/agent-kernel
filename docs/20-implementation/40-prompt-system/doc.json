    "b-40-prompt-system-why-the-standalone-28": {
      "id": "b-40-prompt-system-why-the-standalone-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why:",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The standalone tailer package was dissolved (design D80): once\nin-process emission became primary, a separate package's only effect was\nletting the recovery mapper and the live emitter version-skew. Co-location\nkeeps their id-parity guarantee an intra-package test."
        }
