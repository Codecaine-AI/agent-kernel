            "name": "label",
            "type": "string",
            "required": false,
            "description": "Picker label. Defaults to the fixture id, the file name without .json."
          },
          {
            "name": "variables",
            "type": "object",
            "required": false,
            "description": "Overlays the manifest variable defaults for the preview SpawnContext. A non-object value skips the file."
          },
