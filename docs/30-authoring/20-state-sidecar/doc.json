        "example": "{\n  \"label\": \"Stale base\",\n  \"variables\": { \"objective\": \"Reconcile the branch\" },\n  \"state\": {\n    \"objective\": \"Reconcile the branch\",\n    \"eventsSeen\": 4\n  }\n}",
        "fields": [
