    "rw-binding-shape": {
      "id": "rw-binding-shape",
      "type": "state-shape",
      "props": {
        "example": "{\"bindingId\":\"agent-kernel-pre-pr-review\",\"hostId\":\"my-trigger-host\",\"runAsUserId\":\"my-archon-user-id\",\"resource\":\"github:Codecaine-AI/agent-kernel:review\",\"capacity\":1,\"overlap\":\"queue\",\"launch\":{\"cwd\":\"/path/to/agent-kernel\",\"workflowName\":\"pre-pr-review\",\"inputs\":{},\"isolation\":{\"kind\":\"in-place\"}},\"selector\":{\"kind\":\"pr.lifecycle\",\"actions\":[\"opened\",\"head_updated\"],\"repository\":{\"host\":\"github.com\",\"path\":\"Codecaine-AI/agent-kernel\"},\"predicates\":[{\"field\":\"pr.base.branch\",\"equals\":\"main\"}]},\"inputMapping\":{\"scope\":{\"source\":\"field\",\"field\":\"subject.number\"}}}",
        "fields": [
          {
            "name": "bindingId",
            "type": "string",
            "description": "Stable id. A replayed delivery reuses the binding snapshot it first matched."
          },
          {
            "name": "hostId",
            "type": "string",
            "description": "Must equal ARCHON_TRIGGER_HOST on the server that starts the runs."
          },
          {
            "name": "runAsUserId",
            "type": "string",
            "description": "The Archon user the run executes as. The GitHub actor never selects it."
          },
          {
            "name": "resource",
            "type": "string",
            "description": "Names the work that must not overlap. Every binding on it must declare the same capacity."
          },
          {
            "name": "capacity",
            "type": "integer",
            "required": false,
            "description": "Runs that can hold the resource at once. Default 1."
          },
          {
            "name": "overlap",
            "type": "\"queue\" | \"skip\"",
            "description": "queue keeps the request in durable FIFO order. skip records the blocker and drops it."
          },
          {
            "name": "launch",
            "type": "object",
            "fields": [
              {
                "name": "cwd",
                "type": "string",
                "description": "Absolute checkout path the run starts in."
              },
              {
                "name": "workflowName",
                "type": "string",
                "description": "The workflow to start. Here the review pack."
              },
              {
                "name": "inputs",
                "type": "object",
                "description": "Literal inputs merged with inputMapping."
              },
              {
                "name": "isolation",
                "type": "object",
                "fields": [
                  {
                    "name": "kind",
                    "type": "string",
                    "description": "`in-place` runs in the `cwd` checkout as it is, with no worktree. The run reviews whatever commit that checkout holds."
                  }
                ]
              }
            ]
          },
          {
            "name": "selector",
            "type": "object",
            "fields": [
              {
                "name": "kind",
                "type": "\"pr.lifecycle\"",
                "description": "The source event kind for pull_request events."
              },
              {
                "name": "actions",
                "type": "string[]",
                "description": "Matching lifecycle actions. The plugin maps GitHub's `synchronize` to `head_updated`."
              },
              {
                "name": "repository",
                "type": "object",
                "fields": [
                  {
                    "name": "host",
                    "type": "string"
                  },
                  {
                    "name": "path",
                    "type": "string",
                    "description": "owner/repo"
                  }
                ]
              },
              {
                "name": "predicates",
                "type": "{ field, equals }[]",
                "required": false
              }
            ]
          },
          {
            "name": "inputMapping",
            "type": "Record<string, { source, field | value }>",
            "description": "source field copies an event field. source literal supplies a typed JSON value."
          }
        ],
        "name": "Review pack binding",
        "source": {
          "path": "packages/docs-web/src/content/docs/guides/workflow-triggers.md"
        }
      },
      "children": []
    },
