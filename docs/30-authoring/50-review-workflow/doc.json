          "insert": "extract",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " node and a "
        },
        {
          "insert": "decide",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " node beside Claude Code and Codex nodes. Greptile and CodeRabbit then review what survives."
        }
      ],
      "children": []
    },
    "rc-lead": {
      "id": "rc-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pack lives at "
        },
        {
          "insert": ".archon/workflows/codecaine/pre-pr-review/pre-pr-review.yaml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It is written from upstream "
        },
        {
          "insert": "archon-review",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in Archon's sdlc pack, at a pinned commit. It removes the 6 lens nodes and the route agent, and adds one kernel node, two nodes in the fork's node modes, and 2 static reviewers."
        }
