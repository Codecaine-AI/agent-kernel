      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "pre-pr-review",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " workflow reviews a pull request of this repo before it merges. It runs on the Archon fork, with a kernel node, an "
