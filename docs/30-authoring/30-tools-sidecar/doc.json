          "insert": "{\n  \"$schema\": \"agent-kernel/agent-v1\",\n  \"name\": \"report-writer\",\n  \"description\": \"Writes a report from supplied evidence.\",\n  \"model\": \"default\",\n  \"coreTools\": [\"read\", \"write\"]\n}"
