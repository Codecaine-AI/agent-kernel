    "b-30-tools-sidecar-ts-11": {
      "id": "b-30-tools-sidecar-ts-11",
      "type": "code",
      "props": {
        "language": "ts"
      },
      "text": [
        {
          "insert": "import { defineTools } from \"@agent-kernel/kernel/agent-definition\";\nimport { Type } from \"@earendil-works/pi-ai\";\n\ninterface ReportRuntime {\n  writeReport(content: string): Promise<string>;\n}\n\nexport const tools = defineTools<ReportRuntime>((pi, runtime) => {\n  pi.registerTool({\n    name: \"write_report\",\n    label: \"Write report\",\n    description: \"Persist the final Markdown report.\",\n    parameters: Type.Object({ content: Type.String() }),\n    execute: async (_toolCallId, { content }) => {\n      if (!runtime) throw new Error(\"Report runtime is required.\");\n      const path = await runtime.writeReport(content);\n      return {\n        content: [{ type: \"text\", text: `Wrote ${path}` }],\n        details: { path },\n      };\n    },\n  });\n});\n\nexport default tools;"
        }
      ],
      "children": []
    },
    "b-30-tools-sidecar-surface": {
      "id": "b-30-tools-sidecar-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "defineTools<R>",
            "kind": "action",
            "description": "Typing helper: returns the register function unchanged. Export it as the default export, the named tools export, or both.",
            "params": [
              {
                "name": "register",
                "type": "(pi: ExtensionAPI, runtime?: R) => void | Promise<void>",
                "required": true,
                "description": "Runs once at registry boot with a stub pi and runtime undefined, then once per spawn with the session's pi and the createKernel toolRuntime."
              }
            ],
            "returns": "the same register function"
          },
          {
            "name": "pi.registerTool",
            "kind": "action",
            "description": "Registers one private tool. The name joins the agent's tool allowlist at boot.",
            "params": [
              {
                "name": "tool",
                "type": "ToolDefinition",
                "required": true,
                "fields": [
                  {
                    "name": "name",
                    "type": "string",
                    "required": true,
                    "description": "Stable and unique within the agent."
                  },
                  {
                    "name": "label",
                    "type": "string",
                    "required": true,
                    "description": "UI label."
                  },
                  {
                    "name": "description",
                    "type": "string",
                    "required": true,
                    "description": "Model-facing description."
                  },
                  {
                    "name": "parameters",
                    "type": "TSchema",
                    "required": true,
                    "description": "TypeBox schema. Boot serializes it to plain JSON for the lab's Tools view."
                  },
                  {
                    "name": "execute",
                    "type": "(toolCallId, params, signal, onUpdate, ctx) => Promise<AgentToolResult>",
                    "required": true,
                    "description": "Never runs at boot. Returns { content, details }."
                  },
                  {
                    "name": "promptSnippet",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "executionMode",
                    "type": "\"sequential\" | \"parallel\"",
                    "required": false
                  }
                ]
              }
            ],
            "returns": "void"
          },
          {
            "name": "defineSpawnerTool",
            "kind": "action",
            "description": "Compiles a spawner declaration into a tool for pi.registerTool. Throws on an empty spawns list or a wildcard mixed with names. Its execute runs only inside kernel-spawned sessions.",
            "params": [
              {
                "name": "decl",
                "type": "SpawnerToolDeclaration",
                "required": true,
                "fields": [
                  {
                    "name": "name",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "label",
                    "type": "string",
                    "required": false,
                    "description": "Defaults to name."
                  },
                  {
                    "name": "description",
                    "type": "string",
                    "required": false,
                    "description": "Defaults to Dispatch subagents (<spawns>)."
                  },
                  {
                    "name": "parameters",
                    "type": "TSchema",
                    "required": true
                  },
                  {
                    "name": "spawns",
                    "type": "string[]",
                    "required": true,
                    "description": "Agent names this tool may dispatch, or exactly [\"*\"] for any catalog agent. Boot fails when a named target is not in the catalog."
                  },
                  {
                    "name": "executionMode",
                    "type": "\"sequential\" | \"parallel\"",
                    "required": false,
                    "description": "Defaults to sequential."
                  },
                  {
                    "name": "execute",
                    "type": "(toolCallId, params, ctx) => Promise<AgentToolResult>",
                    "required": true,
                    "fields": [
                      {
                        "name": "ctx.dispatch",
                        "type": "SpawnerDispatch",
                        "required": true
                      },
                      {
                        "name": "ctx.toolRuntime",
                        "type": "R",
                        "required": false,
                        "description": "The createKernel toolRuntime."
                      },
                      {
                        "name": "ctx.signal",
                        "type": "AbortSignal",
                        "required": false
                      }
                    ]
                  }
                ]
              }
            ],
            "returns": "SpawnerToolDefinition"
          },
          {
            "name": "ctx.dispatch",
            "kind": "action",
            "description": "Rejects agents outside spawns or outside the catalog. Forwards parentToolUseId, trigger parent-tool, and the parent's run identity automatically.",
            "params": [
              {
                "name": "agentName",
                "type": "string",
                "required": true
              },
              {
                "name": "prompt",
                "type": "string",
                "required": true
              },
              {
                "name": "opts",
                "type": "object",
                "required": false,
                "fields": [
                  {
                    "name": "background",
                    "type": "boolean",
                    "required": false,
                    "description": "Queue on the background lane and resolve at once with a handle whose done promise yields the final record."
                  },
                  {
                    "name": "description",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "displayLabel",
                    "type": "string",
                    "required": false
                  },
                  {
                    "name": "variables",
                    "type": "Record<string, unknown>",
                    "required": false
                  },
                  {
                    "name": "workingDir",
                    "type": "string",
                    "required": false,
                    "description": "Defaults to the parent session's cwd."
                  }
                ]
              }
            ],
            "returns": "Promise<AgentRecord>, or Promise<SpawnerBackgroundHandle> when background is true"
          }
        ],
        "title": "Tools Sidecar Surface"
      },
      "children": []
    },
