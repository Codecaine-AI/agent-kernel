        {
          "insert": "Non-Negotiables"
        }
      ],
      "children": []
    },
    "b-00-overview-author-agent-json-and-22": {
      "id": "b-00-overview-author-agent-json-and-22",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Author "
        },
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and PromptKit JSON; do not create "
        },
        {
          "insert": "agent.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "prompt.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or an authored "
        },
        {
          "insert": "agent.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as bundle sources."
        }
      ],
      "children": []
    },
    "b-00-overview-treat-prompt-json-or-23": {
      "id": "b-00-overview-treat-prompt-json-or-23",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Treat "
        },
        {
          "insert": "prompt.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "prompt/prompt.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as the prompt source of truth. Regenerate the adjacent Markdown snapshot; never hand-edit it."
        }
      ],
      "children": []
    },
    "b-00-overview-put-dynamic-reference-lo-24": {
      "id": "b-00-overview-put-dynamic-reference-lo-24",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Put dynamic reference loading in context, private actions in tools, and live working state in state. Do not move those runtime concerns into PromptKit."
        }
      ],
      "children": []
