      "text": [
        {
          "insert": "This tier is a declared "
        },
        {
          "insert": "guides extension",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": task-facing how-to material for bundle authors. It is non-normative: authority over behavior and contracts stays with "
        },
        {
          "insert": "10-system-design",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design",
              "label": "10-system-design"
            }
          }
        },
        {
          "insert": ", and authority over code structure stays with "
        },
        {
          "insert": "20-implementation",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "20-implementation",
              "label": "20-implementation"
            }
          }
        },
        {
          "insert": ". Where this tier and those layers disagree, the layers win and this tier has a bug."
        }
      ],
