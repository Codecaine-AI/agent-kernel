    "b-00-overview-for-generated-snapshots-7": {
      "id": "b-00-overview-for-generated-snapshots-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For generated snapshots, boot checks, catalog doctor, or viewer expectations, use "
        },
        {
          "insert": "Validation and Inspection",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-authoring/40-validation",
              "label": "Validation and Inspection"
            }
          }
        },
        {
          "insert": ". Changes to the registry, request builder, traces, or viewer are implementation work rather than bundle authoring; follow the "
        },
        {
          "insert": "kernel implementation overview",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "20-implementation/20-kernel",
              "label": "kernel implementation overview"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
