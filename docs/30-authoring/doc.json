      "children": []
    },
    "b-00-overview-the-canonical-prompt-ord-18": {
      "id": "b-00-overview-the-canonical-prompt-ord-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canonical prompt order is "
        },
        {
          "insert": "purpose",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", optional "
        },
        {
          "insert": "goal",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "state_structure",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "workflow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", optional "
        },
        {
          "insert": "error_handling",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", optional "
        },
        {
          "insert": "success_criteria",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", then "
        },
        {
          "insert": "rules",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " last. Do not add a tools section, context-inventory section, or reminders section. Tool guidance belongs in context ②, executable schemas belong to the tool layer, and the full prompt-structure treatment belongs in the prompt-kit repo, "
        },
        {
          "insert": "docs/30-prompt-structure/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-00-overview-every-prompt-variable-mu-19": {
      "id": "b-00-overview-every-prompt-variable-mu-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every prompt variable must be declared in "
        },
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Every declaration must match actual prompt usage. Keep PromptKit generic: kernel runtime configuration, context loading, private tool implementation, and state transitions stay outside the prompt document."
        }
      ],
      "children": []
    },
    "b-00-overview-section-contains-stand-20": {
      "id": "b-00-overview-section-contains-stand-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Section ② contains standing reference material. Anything that moves during the run belongs to section ③, including the conversation tail. For the complete state contract and three-section request assembly, use the "
        },
        {
          "insert": "runtime model's state section",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-runtime-model",
              "label": "runtime model's state section"
            }
          }
        },
        {
          "insert": " rather than duplicating those internals here."
        }
      ],
      "children": []
    },
    "b-00-overview-non-negotiables-21": {
      "id": "b-00-overview-non-negotiables-21",
