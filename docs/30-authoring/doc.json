        }
      ],
      "children": []
    },
    "b-00-overview-an-agent-bundle-is-one-d-9": {
      "id": "b-00-overview-an-agent-bundle-is-one-d-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An agent bundle is one directory containing "
        },
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus four runtime sections: prompt, context, tools, and state. Prompt is required. Context, tools, and state are optional. The bundle file tree, with the role of every file, lives in "
        },
        {
          "insert": "Documents and Bundles",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-prompt-system-model/10-documents-and-bundles",
              "label": "Documents and Bundles"
            }
          }
        },
        {
          "insert": ". To start a new bundle, copy the folder of the closest canonical example below and delete the sections the agent does not need."
        }
      ],
      "children": []
    },
    "b-00-overview-the-layout-follows-d98-i-11": {
      "id": "b-00-overview-the-layout-follows-d98-i-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The layout follows decision D98 in "
        },
        {
          "insert": "State Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-prompt-system-model/30-state-model",
              "label": "State Model"
            }
          }
        },
        {
          "insert": ". Each section may stay as one file or expand into a folder whose listed entry point is the only discovered file. Resolution is file first, folder second. If both forms exist, the file wins and catalog doctor reports the shadowed folder. Folder internals, such as "
        },
        {
          "insert": "tools/runtime.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "docs-writer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", remain private to the section. Fixture folders are preview data: the spawn pipeline never reads them."
        }
      ],
      "children": []
    },
    "b-00-overview-agent-json-owns-the-du-12": {
      "id": "b-00-overview-agent-json-owns-the-du-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns the durable manifest. The manifest state shape in "
        },
        {
          "insert": "Documents and Bundles",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-prompt-system-model/10-documents-and-bundles",
              "label": "Documents and Bundles"
            }
          }
        },
        {
          "insert": " defines the durable manifest's fields, defaults, and nested "
        },
        {
          "insert": "variables",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "variants",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "state.window",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " shapes. Add only the fields the agent needs: unknown keys fail validation at every level ("
        },
        {
          "insert": "packages/kernel/src/agent-definition/agent-manifest-schema.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/kernel/src/agent-definition/agent-manifest-schema.ts"
            }
          }
        },
        {
          "insert": "). Section sidecars attach by filename convention rather than explicit imports."
        }
      ],
      "children": []
    },
    "b-00-overview-host-declares-where-th-13": {
      "id": "b-00-overview-host-declares-where-th-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "host",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " declares where the agent may run. "
        },
        {
          "insert": "\"app\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (the default when the field is absent) means the bundle runs only inside its owning app harness: its sidecars may import app services, and standalone harnesses (the pi TUI, sub-agent spawns outside the app) classify it from the manifest without evaluating those sidecars. "
        },
        {
          "insert": "\"any\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " means the bundle is standalone-safe: every sidecar must load under plain Node with no app runtime; catalog doctor's host portability check ("
        },
        {
          "insert": "agent-kernel-doctor --catalog",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") verifies this. Declare "
        },
        {
          "insert": "\"any\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " only when it is true; the declaration is trusted, not probed."
        }
      ],
      "children": []
    },
    "b-00-overview-disallowedtools-is-enf-14": {
      "id": "b-00-overview-disallowedtools-is-enf-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "disallowedTools",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is enforced in every runtime: the spawn pipeline applies it as the session tool disallowlist, and the pi TUI blocks the listed built-ins at "
        },
        {
          "insert": "tool_call",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " while the agent is active (interactive sessions keep their built-in tools, so blocking is the enforcement). Use it to force an agent's mutations through its own typed tools sidecar while leaving reads open. For example, "
        },
        {
          "insert": "docs-writer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " disallows "
        },
        {
          "insert": "write",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "edit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and writes docs only through its validated "
        },
        {
          "insert": "docs_write",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tool."
        }
      ],
      "children": []
    },
    "b-00-overview-there-is-no-authored-ag-15": {
      "id": "b-00-overview-there-is-no-authored-ag-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no authored "
        },
        {
          "insert": "agent.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " entry point in the current bundle contract. Older guidance that assigns manifest or composition responsibilities to "
        },
        {
          "insert": "agent.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is obsolete. Those responsibilities belong to "
        },
        {
          "insert": "agent.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the convention-discovered sections. The "
        },
        {
          "insert": "runtime model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-runtime-model",
              "label": "runtime model"
            }
          }
        },
        {
          "insert": " is authoritative for discovery and normalization."
        }
      ],
      "children": []
    },
    "b-00-overview-the-four-sections-16": {
      "id": "b-00-overview-the-four-sections-16",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Four Sections"
        }
      ],
      "children": []
    },
    "b-00-overview-sections-table": {
      "id": "b-00-overview-sections-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Section",
          "Authoring responsibility",
          "Request boundary"
        ],
        "rows": [
          [
            "Prompt",
            [
              {
                "insert": "Stable behavior expressed as a PromptKit "
              },
              {
                "insert": "PromptDocument",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " in JSON."
              }
            ],
            "① system prompt"
          ],
          [
            "Context",
            "Load and assemble standing reference material that should remain visible.",
            "② rebuilt context message"
          ],
          [
            "Tools",
            "Declare private executable actions and bind their runtime services.",
            "Provider tool schemas and execution"
          ],
          [
            "State",
            "Seed, update, and render the moving work picture plus the chosen conversation tail.",
            "③ rendered state"
          ]
        ]
