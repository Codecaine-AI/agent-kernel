    "b-40-validation-run-static-checks-after-2": {
      "id": "b-40-validation-run-static-checks-after-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run static checks after every bundle change, then inspect one representative runtime trace. Static validation can prove the bundle is loadable. Only a spawn can exercise dynamic data and tool behavior."
        }
      ],
      "children": []
    },
