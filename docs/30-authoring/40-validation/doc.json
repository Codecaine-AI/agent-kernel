    "b-40-validation-fix-these-before-running-14": {
      "id": "b-40-validation-fix-these-before-running-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Boot collects every per-agent error into one "
        },
        {
          "insert": "AggregateError",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "packages/kernel/src/agent-registry/registry/registry.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/kernel/src/agent-registry/registry/registry.ts"
            }
          }
        },
        {
          "insert": "), so one boot run lists every broken agent. Spawn-stage failures appear in trace events or tool results because their inputs do not exist at boot."
        }
      ],
      "children": []
    },
