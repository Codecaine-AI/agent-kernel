    "b-40-validation-pipeline": {
      "id": "b-40-validation-pipeline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Validate an agent bundle",
            "steps": [
              {
                "text": "Regenerate the committed prompt render when the prompt changed",
                "steps": [
                  {
                    "text": "`bunx agent-kernel-render-prompts <catalog-root>`",
                    "kind": "note"
                  },
                  {
                    "text": "`--agent` treats each path as one bundle directory. `--no-canonical` leaves `prompt.json` bytes unchanged.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Check the render with `--check`",
                "steps": [
                  {
                    "text": "`bunx agent-kernel-render-prompts --check <catalog-root>` writes nothing and exits non-zero on a stale render.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Boot the registry through app startup or its catalog test",
                "steps": [
                  {
                    "text": "Boot reports every broken agent at once. See the failure catalog below.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Run the catalog doctor",
                "steps": [
                  {
                    "text": "`bunx agent-kernel-doctor --catalog <catalog-root...> --strict`",
                    "kind": "note"
                  },
                  {
                    "text": "Layout and host-portability findings print as warnings. Only `--strict` exits 1.",
                    "kind": "note"
                  },
                  {
                    "text": "The host check loads the sidecars of every `host: \"any\"` bundle under Node through jiti.",
                    "kind": "note"
                  },
                  {
                    "text": "Without `--catalog`, the command runs the trace-database doctor.",
                    "kind": "note"
                  }
                ]
              },
              {
                "text": "Open the agent lab",
                "steps": [
                  {
                    "text": "Inspect the System, Context, State, and Tools views"
                  },
                  {
                    "text": "Switch context and state fixtures with the fixture pickers"
                  }
                ]
              },
              {
                "text": "Run a representative spawn",
                "steps": [
                  {
                    "text": "Kernel emits `context_build_started`, then one `context_input_resolved` per loader",
                    "trace": true
                  },
                  {
                    "text": "Kernel emits `context_build_completed` with the rendered context",
                    "trace": true
                  },
                  {
                    "text": "Inspect the Turn view and tool results"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
