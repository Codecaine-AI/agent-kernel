          "insert": "runtime model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-runtime-model"
            }
          }
        },
        {
          "insert": " owns the resolver, status, and trace contracts. Declare one of these kinds:"
        }
