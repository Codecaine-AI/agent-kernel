    "b-10-context-sidecar-use-definecontext-to-d-8": {
      "id": "b-10-context-sidecar-use-definecontext-to-d-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use "
        },
        {
          "insert": "defineContext",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to declare loaders and assemble their ordered results into one model-facing string:"
        }
      ],
      "children": []
    },
    "b-10-context-sidecar-ts-9": {
      "id": "b-10-context-sidecar-ts-9",
      "type": "code",
      "props": {
        "language": "ts"
      },
      "text": [
        {
          "insert": "import { defineContext } from \"@agent-kernel/kernel/agent-definition\";\nimport type {\n  AgentContextResolver,\n  LoadedMap,\n  SpawnContext,\n} from \"@agent-kernel/kernel/context\";\n\nconst loaders: AgentContextResolver[\"loaders\"] = [\n  { kind: \"file\", path: \"reference/style-guide.md\" },\n  {\n    kind: \"directory\",\n    pattern: \"reference/examples/**/*.md\",\n    extensions: [\".md\"],\n  },\n];\n\nfunction assemble(loaded: LoadedMap, ctx: SpawnContext): string {\n  return [\n    \"<agent_reference>\",\n    `<agent_name>${ctx.agentName}</agent_name>`,\n    ...loaded.map((input) => input.content),\n    \"</agent_reference>\",\n  ].join(\"\\n\\n\");\n}\n\nexport const context = defineContext({ loaders, assemble });\nexport default context;"
        }
      ],
      "children": []
    },
    "b-10-context-sidecar-define-context-surface": {
      "id": "b-10-context-sidecar-define-context-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "defineContext",
            "kind": "action",
            "description": "Typing helper: returns the resolver unchanged. Export the result as the default export, the named context export, or both.",
            "params": [
              {
                "name": "resolver",
                "type": "AgentContextResolver",
                "required": true,
                "fields": [
                  {
                    "name": "loaders",
                    "type": "LoaderDeclaration[]",
                    "required": true,
                    "description": "Resolved in declaration order on every context build. See the loader kinds table below."
                  },
                  {
                    "name": "assemble",
                    "type": "(loaded, ctx) => string | Promise<string>",
                    "required": true
                  },
                  {
                    "name": "assembleImages",
                    "type": "(loaded, ctx) => ContextImage[] | Promise<ContextImage[]>",
                    "required": false,
                    "description": "Omit for text-only context."
                  }
                ]
              }
            ],
            "returns": "AgentContextResolver, the same object"
          },
          {
            "name": "resolver.assemble",
            "kind": "query",
            "description": "The kernel calls it after every loader has resolved. Its string is the section ② context entry. A loader failure becomes an error entry in loaded; a throw from assemble fails the context build.",
            "params": [
              {
                "name": "loaded",
                "type": "LoadedMap",
                "required": true,
                "description": "Readonly array with one LoadedInput per declaration, in declaration order.",
                "fields": [
                  {
                    "name": "decl",
                    "type": "LoaderDeclaration",
                    "required": true
                  },
                  {
                    "name": "status",
                    "type": "\"ok\" | \"empty\" | \"error\"",
                    "required": true
                  },
                  {
                    "name": "content",
                    "type": "string",
                    "required": true,
                    "description": "Empty string when status is error."
                  },
                  {
                    "name": "bytes",
                    "type": "number",
                    "required": true
                  },
                  {
                    "name": "hash",
                    "type": "string",
                    "required": true,
                    "description": "sha256 of content; empty string on error."
                  },
                  {
                    "name": "error",
                    "type": "string",
                    "required": false,
                    "description": "Set when status is error, for example Unknown loader kind: x."
                  },
                  {
                    "name": "fromCache",
                    "type": "boolean",
                    "required": true
                  }
                ]
              },
              {
                "name": "ctx",
                "type": "SpawnContext",
                "required": true,
                "fields": [
                  {
                    "name": "agentName",
                    "type": "string",
                    "required": true
                  },
                  {
                    "name": "variables",
                    "type": "Record<string, unknown>",
                    "required": true
                  },
                  {
                    "name": "caller",
                    "type": "{ kind: \"user\" | \"agent\" | \"system\", id: string }",
                    "required": true
                  },
                  {
                    "name": "runtime",
                    "type": "RuntimeState",
                    "required": true,
                    "description": "cwd plus optional containerId, sessionDir, topic, phase, and status."
                  },
                  {
                    "name": "paths",
                    "type": "{ workingDir, activeSessionDir, priorSessionsDir? }",
                    "required": true,
                    "description": "Loaders resolve relative paths against workingDir. activeSessionDir is workingDir/active_session."
                  },
                  {
                    "name": "sessionData",
                    "type": "AppSessionData | null",
                    "required": false,
                    "description": "Unset on live spawns. Catalog previews set it from a context fixture."
                  }
                ]
              }
            ],
            "returns": "string | Promise<string>"
          },
          {
            "name": "resolver.assembleImages",
            "kind": "query",
            "description": "Optional. Runs after assemble. The returned images ride with the rendered text in the injected context entry.",
            "params": [
              {
                "name": "loaded",
                "type": "LoadedMap",
                "required": true
              },
              {
                "name": "ctx",
                "type": "SpawnContext",
                "required": true
              }
            ],
            "returns": "ReadonlyArray<{ data: string, mimeType: string }>, where data is base64"
          }
        ],
        "title": "Context Sidecar Surface"
      },
      "children": []
    },
    "b-10-context-sidecar-each-loadedmap-entry-r-11": {
      "id": "b-10-context-sidecar-each-loadedmap-entry-r-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decide in "
