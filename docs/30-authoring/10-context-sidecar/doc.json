    "b-10-context-sidecar-the-bundle-owns-loader-d-10": {
      "id": "b-10-context-sidecar-the-bundle-owns-loader-d-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The bundle owns loader declarations and assembly. Loader implementations are kernel- or app-registered infrastructure ("
