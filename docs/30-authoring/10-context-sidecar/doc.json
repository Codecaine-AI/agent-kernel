    "b-10-context-sidecar-use-either-context-ts-5": {
      "id": "b-10-context-sidecar-use-either-context-ts-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use either "
        },
        {
          "insert": "context.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "context/index.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Both forms are permanent; choose the folder form when loader declarations or render helpers need separate files. If both forms exist, the registry uses "
        },
        {
          "insert": "context.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and reports the shadowed folder through catalog diagnostics."
        }
      ],
      "children": []
    },
    "b-10-context-sidecar-the-sidecar-is-optional-6": {
      "id": "b-10-context-sidecar-the-sidecar-is-optional-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The sidecar is optional. When present, its entry point must export the resolver as either the default export or named "
        },
        {
          "insert": "context",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " export."
        }
      ],
      "children": []
    },
