    "b-10-context-sidecar-the-context-sidecar-supp-13": {
      "id": "b-10-context-sidecar-the-context-sidecar-supp-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The context sidecar supplies section ②: standing material that should remain available as requests are rebuilt. Appropriate inputs include capabilities, skills, style guides, reference sheets, and stable supporting evidence."
        }
      ],
      "children": []
    },
    "b-10-context-sidecar-do-not-use-it-for-materi-14": {
      "id": "b-10-context-sidecar-do-not-use-it-for-materi-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Do not use it for material that moves with the work. Target documents, work queues, current requests, editor state, progress, and conversation belong to the state sidecar's section ③ render. Context and state are sibling request sections; state is never nested inside context. The full request and state contract lives in the "
        },
        {
          "insert": "runtime model's state section",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-runtime-model",
              "label": "runtime model's state section"
            }
          }
        },
        {
          "insert": ", with the governing decisions D81–D99 in the "
        },
        {
          "insert": "State Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-prompt-system-model/30-state-model",
              "label": "State Model"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-context-sidecar-when-an-agent-uses-the-s-15": {
      "id": "b-10-context-sidecar-when-an-agent-uses-the-s-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When an agent uses the state extension, the assembled result becomes an entry in the kernel-held context set and is rebuilt into one section ② message per request. Pass-through behavior and current injection details remain implementation concerns; author against the section boundary."
        }
      ],
      "children": []
    },
    "b-10-context-sidecar-if-the-model-needs-stand-16": {
      "id": "b-10-context-sidecar-if-the-model-needs-stand-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If the model needs standing guidance for how to use available tools, supply that guidance through section ②. Tool schemas and executable behavior belong to the tools sidecar. For prompt design, see the prompt-kit repo, "
        },
        {
          "insert": "docs/30-prompt-structure/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
