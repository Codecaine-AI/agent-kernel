    "b-10-purpose-spectre-proved-those-pie-18": {
      "id": "b-10-purpose-spectre-proved-those-pie-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The kernel grew out of Spectre. Spectre proved those pieces are useful, but it mixed them with coding-workflow semantics: sessions, phases, checkpoints, asks, docs, build status, and project worktrees. The kernel separates the reusable platform from the application-specific layer."
        }
      ],
      "children": []
