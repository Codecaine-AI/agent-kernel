    "b-10-purpose-the-kernel-exists-so-age-2": {
      "id": "b-10-purpose-the-kernel-exists-so-age-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The kernel exists so agent systems can share a strong runtime and viewing foundation without sharing the same product workflow, and so that verticals can scale agent work without scaling blind."
        }
      ],
      "children": []
    },
    "b-10-purpose-divider-3": {
