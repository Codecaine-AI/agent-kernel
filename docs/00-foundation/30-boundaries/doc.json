    "b-30-boundaries-a-feature-starts-app-sid-15": {
      "id": "b-30-boundaries-a-feature-starts-app-sid-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A feature starts app-side when its generic shape is unclear. It can move into the kernel only after it proves useful beyond one app and can be expressed without app workflow semantics."
        }
      ],
      "children": []
    },
    "b-30-boundaries-durable-human-in-the-loo-16": {
      "id": "b-30-boundaries-durable-human-in-the-loo-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Durable human-in-the-loop asks are a good example. The suspend/resume mechanics are generic. An app's ask rows and payloads stay app-side until the kernel has a clean cross-app contract."
        }
      ],
      "children": []
