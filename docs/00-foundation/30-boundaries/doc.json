    "b-30-boundaries-area-kernel-responsi-5": {
      "id": "b-30-boundaries-area-kernel-responsi-5",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Area | Kernel Responsibility |\n|---|---|\n| Protocol | Trace event envelope, core event types, trace levels, factories, source conventions |\n| Runtime | "
        },
        {
          "insert": "createKernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", spawn adapter surface, run context, spawn pipeline, turn limits |\n| Agent definitions | Frontmatter parsing, registry, variable validation, dynamic sidecar loading |\n| Context | Base loader catalog and context assembly contract |\n| Subagents | In-process agent manager, queueing, parent tool-call linkage |\n| Observability DB | Containers, Pi agent sessions, agent runs, trace events, read helpers |\n| Tailer | Pi JSONL reading, cursoring, event mapping, queueing, health primitives |\n| Read API | Versioned trace read routes that viewer-core can target |\n| Viewer | Trace DTOs, trace span transforms, reusable tree/detail UI, base viewer shell |"
        }
      ],
      "children": []
    },
    "b-30-boundaries-apps-own-6": {
      "id": "b-30-boundaries-apps-own-6",
      "flavour": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Apps Own"
        }
      ],
      "children": []
    },
    "b-30-boundaries-area-app-responsibil-7": {
      "id": "b-30-boundaries-area-app-responsibil-7",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Area | App Responsibility |\n|---|---|\n| Workflow state | App session rows, phase slices, task/checkpoint graphs, project docs, local artifacts |\n| Workflow rules | When phases start/end, how gates work, what \"done\" means |\n| Domain tools | Tools that mutate app rows or app files |\n| Custom loaders | Loaders that read app-specific state, such as Spectre's checkpoint slice |\n| App APIs | Routes that start, stop, resume, answer, or mutate workflow artifacts |\n| Viewer extensions | Panels and renderers that interpret app-specific labels or custom events |"
        }
      ],
      "children": []
    },
