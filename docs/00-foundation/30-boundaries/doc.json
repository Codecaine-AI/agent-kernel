    "b-30-boundaries-the-adapter-layer-is-the-13": {
      "id": "b-30-boundaries-the-adapter-layer-is-the-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The adapter layer is the code that joins a host app to the kernel. It should be explicit and small enough to audit: identity mapping, schema composition, catalog roots, injected services, custom loaders, API mounts, and viewer plugins all live there rather than leaking into either side. The contract is the "
        },
        {
          "insert": "App Adapter Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-app-adapter-model"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
