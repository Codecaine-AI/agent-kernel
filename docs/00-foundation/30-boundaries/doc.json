    "b-30-boundaries-the-kernel-owns-the-reus-2": {
      "id": "b-30-boundaries-the-kernel-owns-the-reus-2",
      "flavour": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The kernel owns the reusable runtime and observability foundation. A host application owns workflow semantics and product behavior."
        }
      ],
      "children": []
    },
